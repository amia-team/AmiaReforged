@top Program { ModuleDeclaration | (ImportDeclaration | GlobalDeclaration | TypeDeclaration | ImplDeclaration)* (kw<"glyph"> ProgramName ":" EventName Block)? }
ModuleDeclaration { kw<"mod"> ModuleName ModuleBody }
ModuleName { Identifier }
ModuleBody { "{" (ImportDeclaration | PublicDeclaration | GlobalDeclaration | TypeDeclaration | ImplDeclaration)* "}" }
ImportDeclaration { kw<"using"> ModuleName ";"? }
PublicDeclaration { kw<"pub"> (GlobalDeclaration | TypeDeclaration) }

@precedence {
  member @left, call @left, unary @right,
  multiply @left, add @left, compare @left, equal @left,
  and @left, or @left, lambda @right, statement
}

@skip { whitespace | LineComment }

GlobalDeclaration { ConstantDeclaration | FunctionDeclaration }
TypeDeclaration { StructDeclaration | AdtDeclaration }

ConstantDeclaration { kw<"const"> ConstantName (":" TypeName)? ("=" expression)? ";"? }
FunctionDeclaration { kw<"fn"> FunctionName TypeParameters? "(" Parameters ")" ":" TypeName ("=" expression | Block) ";"? }
Parameters { Parameter* }
Parameter { ParameterName (":" TypeName)? ("," | ";")? }

ImplDeclaration { kw<"impl"> TypeParameters? TypeName "{" (FunctionDeclaration | PublicMethod)* "}" }
PublicMethod { kw<"pub"> FunctionDeclaration }

StructDeclaration { kw<"struct"> TypeName FieldBlock }
AdtDeclaration { kw<"type"> TypeName "{" (VariantDeclaration ("," VariantDeclaration)* ","?)? "}" }
VariantDeclaration { VariantName FieldBlock }
FieldBlock { "{" (FieldDeclaration ("," FieldDeclaration)* ","?)? "}" }
FieldDeclaration { FieldName ":" TypeName }
ConstantName { Identifier ("." Identifier)* }
FunctionName { Identifier }
ParameterName { Identifier }
TypeName { Identifier ("." Identifier)* TypeArguments? | CollectionType }
TypeParameters { "<" Identifier ("," Identifier)* ">" }
TypeArguments { "<" ~generic TypeName ("," TypeName)* ">" }
CollectionType { CollectionKind "<" TypeName ("," TypeName)? ">" }
CollectionKind { kw<"List"> | kw<"Dictionary"> }
CollectionConstructor { CollectionType "(" ")" }
ListExpression { "[" (expression ("," expression)* ","?)? "]" }
VariantName { Identifier }
FieldName { Identifier }

ProgramName { Identifier }
EventName { Identifier ("." Identifier)* }
Block { "{" (statement | ";")* "}" }

statement {
  Block | StageDeclaration | LetStatement | VarStatement | IfStatement | WhileStatement | ForeachStatement | ForStatement |
  MatchStatement | BreakStatement | ContinueStatement | ReturnStatement | FailStatement | AssignmentStatement | ExpressionStatement
}

StageDeclaration[@dynamicPrecedence=3] { StageName Block }
StageName { kw<"attempted"> | kw<"started"> | kw<"tick"> | kw<"completed"> | @extend[@name=main]<Identifier, "main"> | @extend[@name=client_enter]<Identifier, "client_enter"> | @extend[@name=level_up]<Identifier, "level_up"> | @extend[@name=respawn]<Identifier, "respawn"> | @extend[@name=confirmed]<Identifier, "confirmed"> | @extend[@name=death]<Identifier, "death"> }
LetStatement { kw<"let"> BindingName "=" expression }
VarStatement { kw<"var"> BindingName "=" expression }
BindingName { Identifier }
IfStatement { kw<"if"> expression Block (kw<"else"> (IfStatement | Block))? }
WhileStatement { kw<"while"> expression Block }
ForStatement { kw<"for"> BindingName kw<"in"> expression (RangeOperator expression (kw<"step"> expression)?)? Block }
RangeOperator { ".." | "..=" }
ForeachStatement { kw<"foreach"> BindingName kw<"in"> expression Block }
MatchStatement { kw<"match"> expression "{" (MatchArm | ";" | ",")* "}" }
MatchArm { MatchPattern Block }
MatchPattern { VariantPattern | ValuePattern | WildcardPattern }
VariantPattern { Identifier ("." PropertyName)* (TypeArguments "." PropertyName)? ~pattern "{" (BindingName ("," BindingName)* ","?)? "}" }
ValuePattern { Identifier ("." PropertyName)* ~pattern | Number | String | Boolean | ("-" | "+") Number }
WildcardPattern { kw<"_"> }
BreakStatement { kw<"break"> }
ContinueStatement { kw<"continue"> }
ReturnStatement { kw<"return"> (expression | ";")? !statement }

FailStatement[@dynamicPrecedence=1] {
  @extend[@name=FailKeyword]<Identifier, "fail"> expression !statement
}

AssignmentStatement { expression AssignmentOperator expression !statement }
ExpressionStatement { expression !statement }

expression {
  LambdaExpression | GenericExpression | CollectionConstructor | ListExpression | VariableName | Number | String | UnterminatedString | Boolean | ParenthesizedExpression |
  UnaryExpression | BinaryExpression | MemberExpression | IndexExpression | CallExpression
}

LambdaExpression { "|" LambdaParameter "|" expression !lambda }
LambdaParameter { Identifier }
VariableName { Identifier }
Boolean { kw<"true"> | kw<"false"> }
ParenthesizedExpression { "(" expression ")" }
UnaryExpression { ("!" | "+" | "-") expression !unary }

BinaryExpression {
  expression !multiply MultiplyOperator expression |
  expression !add ("+" | "-") expression |
  expression !compare ~generic CompareOperator expression |
  expression !equal EqualityOperator expression |
  expression !and "&&" expression |
  expression !or "||" expression
}

GenericExpression { expression !call ~generic TypeArguments }
MemberExpression { expression !member "." PropertyName }
PropertyName { Identifier }
IndexExpression { expression !member "[" expression "]" }
CallExpression[@dynamicPrecedence=2] { expression !call ArgumentList }
ArgumentList { "(" (Argument ("," Argument)* ","?)? ")" }
Argument { (ArgumentName ":")? expression }
ArgumentName {
  Identifier | kw<"mod"> | kw<"using"> | kw<"pub"> | kw<"glyph"> | kw<"struct"> | kw<"type"> | kw<"match"> | kw<"let"> |
  kw<"var"> | kw<"while"> | kw<"for"> | kw<"continue"> | kw<"step"> |
  kw<"if"> | kw<"else"> | kw<"foreach"> | kw<"in"> | kw<"break"> |
  kw<"attempted"> | kw<"started"> | kw<"tick"> | kw<"completed"> | @extend[@name=client_enter]<Identifier, "client_enter"> | @extend[@name=level_up]<Identifier, "level_up"> | @extend[@name=respawn]<Identifier, "respawn"> | @extend[@name=confirmed]<Identifier, "confirmed"> | @extend[@name=death]<Identifier, "death"> | kw<"fn"> | kw<"const"> | kw<"return"> | kw<"impl"> | kw<"List"> | kw<"Dictionary">
}
AssignmentOperator { "=" | "+=" | "-=" | "*=" | "/=" }
kw<term> { @specialize[@name={term}]<Identifier, term> }

@external tokens identifiers from "./glyph-tokens.js" { Identifier }

CompareOperator { "<" ~generic | "<=" | ">" | ">=" }

@tokens {
  "|" "(" ")" "{" "}" "[" "]" "<" ">" "<=" ">=" "." "," ":" ";"
  "+" "-" "!" "&&" "||" "=" "+=" "-=" "*=" "/=" ".." "..="
  whitespace { $[\u0009-\u000d\u0020\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]+ }
  LineComment { "//" ![\n]* }
  Number { @digit+ ("." @digit+)? }
  UnterminatedString { '"' ("\\" _ | !["\\\n\r])* "\\"? }
  @precedence { String, UnterminatedString }
  String { '"' ("\\" _ | !["\\\n\r])* '"' }
  MultiplyOperator { "*" | "/" | "%" }
  EqualityOperator { "==" | "!=" }
  @precedence { LineComment, MultiplyOperator }
}

@detectDelim
