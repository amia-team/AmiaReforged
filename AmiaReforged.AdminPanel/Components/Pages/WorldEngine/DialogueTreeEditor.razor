@using AmiaReforged.Shared.Dialogue
@using AmiaReforged.AdminPanel.Models
@using AmiaReforged.AdminPanel.Services
@using AmiaReforged.AdminPanel.Components.Shared
@inject DialogueApiService Api
@inject IWorldEngineEndpointService Endpoints

<div class="dialogue-editor d-flex flex-column h-100">
    <div class="d-flex align-items-center gap-2 p-2 border-bottom bg-dark">
        @if (_editItem != null)
        {
            <button class="btn btn-sm btn-outline-secondary" @onclick="BackToList" disabled="@_isSaving" aria-label="Back to dialogues"><i class="bi bi-arrow-left"></i></button>
            <strong class="text-light text-truncate">@_editItem.Title</strong>
            <div class="ms-auto d-flex gap-2">
                <button class="btn btn-sm btn-outline-info" @onclick="StartPreviewAsync">Preview</button>
                <button class="btn btn-sm btn-success" @onclick="SaveAsync" disabled="@_isSaving">@(_isSaving ? "Saving…" : "Save & Apply")</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="BackToList" disabled="@_isSaving">Cancel</button>
            </div>
        }
        else
        {
            <strong class="text-light">Dialogues</strong>
            <button class="btn btn-sm btn-primary ms-auto" @onclick="CreateNew">New dialogue</button>
        }
    </div>
    <div class="small text-muted px-3 py-2 border-bottom">
        Server: <strong>@_endpointName</strong>. Saved changes apply to new conversations. Open conversations finish their current revision.
    </div>
    @if (_errorMessage != null) { <div class="alert alert-danger m-2 small" style="white-space:pre-wrap">@_errorMessage</div> }
    @if (_runtimeStatus != null && _editItem != null)
    {
        <div class="alert @(_runtimeStatus.State == "Failed" ? "alert-danger" : _runtimeStatus.State == "Applied" ? "alert-success" : "alert-warning") m-2 py-2 small d-flex align-items-center gap-2">
            <span>
                @if (_runtimeStatus.State == "Applied") { <text>Saved revision applied · @_runtimeStatus.MatchedNpcCount matching NPC(s).</text> }
                else if (_runtimeStatus.State == "Failed") { <text>Saved, but runtime application failed: @_runtimeStatus.Error</text> }
                else { <text>Saved · runtime application is pending.</text> }
                @if (_runtimeStatus.State == "Applied" && _runtimeStatus.MatchedNpcCount == 0 && !string.IsNullOrWhiteSpace(_editItem.SpeakerTag))
                { <text> No NPC currently has this tag. Newly spawned NPCs are checked on the module heartbeat.</text> }
            </span>
            <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="RefreshRuntimeStatusAsync">Check status</button>
        </div>
    }
    @if (_editItem == null)
    {
        <div class="flex-grow-1 overflow-auto p-3">
            @if (_isLoading) { <p class="text-muted">Loading dialogues…</p> }
            else if (_dialogueList.Count == 0) { <p class="text-muted">No dialogues on this server.</p> }
            @foreach (DialogueTreeDto item in _dialogueList)
            {
                <div class="d-flex border-bottom py-2 gap-2">
                    <button class="btn text-light text-start flex-grow-1" @onclick="() => OpenEdit(item)">
                        <strong>@item.Title</strong><br /><small class="text-muted">@item.DialogueTreeId · @item.Nodes.Count nodes · @item.SpeakerTag</small>
                    </button>
                    <button class="btn btn-sm btn-outline-danger align-self-center" @onclick="() => DeleteAsync(item)">Delete dialogue</button>
                </div>
            }
        </div>
    }
    else
    {
        <div class="row g-0 flex-grow-1 overflow-auto">
            <div class="col-4 border-end p-2 overflow-auto">
                <div class="d-flex align-items-center gap-1 mb-2">
                    <strong class="small text-light">Conversation flow</strong>
                    <button class="btn btn-sm btn-outline-primary ms-auto" @onclick="AddRootNode">Add greeting</button>
                </div>
                <p class="small text-muted">Conditional greetings run in priority order, then the default greeting. Replies lead to the destination shown below them.</p>
                @foreach (DialogueNodeDto root in _editItem.Nodes.Where(n => n.Type == "Root").OrderBy(n => n.SortOrder).ThenBy(n => n.Id))
                {
                    <DialogueFlowOutline Node="root" Nodes="_editItem.Nodes" SelectedNodeId="@_selectedNode?.Id" DefaultNodeId="@_editItem.RootNodeId" OnSelect="SelectNode" />
                }
                @if (UnlinkedNodes.Count > 0)
                {
                    <strong class="text-warning small">Unlinked nodes</strong>
                    @foreach (DialogueNodeDto node in UnlinkedNodes)
                    { <button class="btn btn-sm text-light text-start w-100" @onclick="() => SelectNode(node)">@NodeLabel(node)</button> }
                }
            </div>
            <div class="col-8 p-3 overflow-auto">
                <fieldset class="border border-secondary rounded p-2 mb-3">
                    <legend class="small text-muted px-1" style="width:auto">Dialogue properties</legend>
                    <div class="row g-2">
                        <div class="col-6"><label class="small text-muted">ID</label><input class="form-control form-control-sm" @bind="_editItem.DialogueTreeId" disabled="@(!_isCreating)" /></div>
                        <div class="col-6"><label class="small text-muted">NPC tag</label><input class="form-control form-control-sm" @bind="_editItem.SpeakerTag" placeholder="npc_tag" /></div>
                        <div class="col-12"><label class="small text-muted">Title</label><input class="form-control form-control-sm" @bind="_editItem.Title" /></div>
                        <div class="col-12"><label class="small text-muted">Designer notes</label><textarea class="form-control form-control-sm" rows="2" @bind="_editItem.Description"></textarea></div>
                        <div class="col-12">
                            <label class="small text-muted">Default greeting</label>
                            <select class="form-select form-select-sm" @bind="_editItem.RootNodeId">
                                <option value="">Select default greeting</option>
                                @foreach (DialogueNodeDto node in _editItem.Nodes.Where(n => n.Type == "Root")) { <option value="@node.Id">@NodeLabel(node)</option> }
                            </select>
                            <small class="text-muted">An unconditional default is used when no conditional greeting matches. A conditional default can also match; if no greeting matches, the conversation will not start.</small>
                        </div>
                    </div>
                </fieldset>
                @if (_selectedNode is { } selected)
                {
                    <fieldset class="border border-primary rounded p-2 mb-3">
                        <legend class="small text-light px-1" style="width:auto">@NodeLabel(selected)</legend>
                        <div class="row g-2 mb-2">
                            <div class="col-6"><label class="small text-muted">Node label</label><input class="form-control form-control-sm" @bind="selected.Name" placeholder="e.g. Offer rat quest" /></div>
                            <div class="col-6">
                                <label class="small text-muted">Type</label>
                                <select class="form-select form-select-sm" value="@selected.Type" @onchange="ChangeNodeType">
                                    <option value="Root">Greeting</option><option value="NpcText">NPC line</option><option value="Action">Action step</option><option value="End">Ending</option>
                                </select>
                            </div>
                            @if (selected.Type == "Root")
                            { <div class="col-6"><label class="small text-muted">Greeting priority (lower runs first)</label><input type="number" class="form-control form-control-sm" @bind="selected.SortOrder" /></div> }
                            <div class="col-6"><label class="small text-muted">Speaker override (NPC tag in this area)</label><input class="form-control form-control-sm" @bind="selected.SpeakerTag" placeholder="Original NPC" /></div>
                        </div>
                        @if (selected.Type != "Action")
                        { <label class="small text-muted">NPC text</label><textarea class="form-control form-control-sm mb-2" rows="4" @bind="selected.Text"></textarea> }
                        <div class="d-flex align-items-center mb-1"><strong class="small text-muted">@(selected.Type == "Root" ? "Greeting conditions" : "Entry conditions")</strong><button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="() => AddNodeCondition(selected)">Add condition</button></div>
                        @foreach (DialogueConditionDto condition in selected.Conditions)
                        { <div class="mb-1"><ConditionEditor Condition="condition" OnRemove="() => selected.Conditions.Remove(condition)" /></div> }
                        <div class="d-flex align-items-center mt-3 mb-1"><strong class="small text-muted">Actions on entry</strong><button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="() => AddAction(selected)">Add action</button></div>
                        @foreach (DialogueActionDto action in selected.Actions.OrderBy(a => a.ExecutionOrder))
                        {
                            <div class="d-flex gap-1 mb-1">
                                <input type="number" class="form-control form-control-sm" style="width:65px" title="Execution order" @bind="action.ExecutionOrder" />
                                <ActionEditor Action="action" OnRemove="() => selected.Actions.Remove(action)" />
                            </div>
                        }
                        @if (selected.Type != "End")
                        {
                            <div class="d-flex align-items-center gap-1 mt-3 mb-2">
                                <strong class="small text-light">@(selected.Type == "Action" ? "Automatic continuation" : "Player replies")</strong>
                                <button class="btn btn-sm btn-outline-primary ms-auto" @onclick="() => AddReply(selected)">Add reply</button>
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => AddDestination(selected, true, false)">Continue to new line</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => AddDestination(selected, true, true)">End conversation</button>
                            </div>
                            @foreach (DialogueChoiceDto choice in selected.Choices.OrderBy(c => c.SortOrder).ToList())
                            {
                                <div class="border border-secondary rounded p-2 mb-2" @key="choice.Id">
                                    <div class="d-flex align-items-center gap-1 mb-2">
                                        <label class="small text-muted"><input type="checkbox" @bind="choice.IsContinue" /> Continue without player speech</label>
                                        <button class="btn btn-sm btn-outline-secondary ms-auto" title="Move reply up" @onclick="() => MoveReply(selected, choice, -1)">↑</button>
                                        <button class="btn btn-sm btn-outline-secondary" title="Move reply down" @onclick="() => MoveReply(selected, choice, 1)">↓</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => selected.Choices.Remove(choice)">Remove reply</button>
                                    </div>
                                    @if (!choice.IsContinue && selected.Type != "Action") { <input class="form-control form-control-sm mb-2" placeholder="What does the player say?" @bind="choice.ResponseText" /> }
                                    <div class="d-flex gap-1 align-items-center">
                                        <span class="small text-muted">Destination</span>
                                        <select class="form-select form-select-sm" @bind="choice.TargetNodeId">
                                            <option value="">Choose destination</option>
                                            @foreach (DialogueNodeDto target in _editItem.Nodes) { <option value="@target.Id">@NodeLabel(target)</option> }
                                        </select>
                                        <button class="btn btn-sm btn-outline-primary text-nowrap" @onclick="() => CreateReplyDestination(choice)">Create line</button>
                                        @if (_editItem.Nodes.FirstOrDefault(n => n.Id == choice.TargetNodeId) is { } destination)
                                        { <button class="btn btn-sm btn-outline-info" @onclick="() => SelectNode(destination)">Edit</button> }
                                    </div>
                                    <div class="d-flex align-items-center mt-2"><span class="small text-muted">Reply conditions</span><button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="() => AddCondition(choice)">Add condition</button></div>
                                    @foreach (DialogueConditionDto condition in choice.Conditions)
                                    { <div class="mt-1"><ConditionEditor Condition="condition" OnRemove="() => choice.Conditions.Remove(condition)" /></div> }
                                </div>
                            }
                            @if (selected.Choices.Count == 0) { <p class="small text-muted">Players can read this line and close with Goodbye. Add replies to continue.</p> }
                        }
                        else { <p class="small text-muted mt-2">Farewell text stays visible until the player closes it. An empty ending closes immediately.</p> }
                        <div class="d-flex gap-2 mt-3">
                            @if (selected.Type == "Root" && selected.Id != _editItem.RootNodeId) { <button class="btn btn-sm btn-outline-warning" @onclick="() => SetAsRoot(selected)">Use as default greeting</button> }
                            <button class="btn btn-sm btn-outline-danger ms-auto" @onclick="() => _pendingDelete = selected">Delete node</button>
                        </div>
                        @if (_pendingDelete?.Id == selected.Id)
                        {
                            <div class="alert alert-warning mt-2 mb-0 small">
                                Delete this node and @IncomingReplyCount(selected.Id) incoming reply link(s)? Destination nodes are kept.
                                <button class="btn btn-sm btn-danger ms-2" @onclick="() => RemoveNode(selected)">Delete node and links</button>
                                <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="() => _pendingDelete = null">Keep node</button>
                            </div>
                        }
                    </fieldset>
                }
                @if (_preview is not null)
                {
                    <fieldset class="border border-info rounded p-3">
                        <legend class="small text-info px-1" style="width:auto">Conversation preview</legend>
                        <p class="small text-muted">Conditions are simulated. Actions are listed without changing game state. Restart after changing the scenario or editing the dialogue.</p>
                        @foreach (DialogueConditionDto condition in _previewConditions)
                        {
                            string key = ConditionKey(condition);
                            <label class="d-block small text-muted"><input type="checkbox" checked="@_previewConditionResults[key]" @onchange="e => _previewConditionResults[key] = e.Value is true" /> @condition.Type (@string.Join(", ", condition.Parameters.Select(p => $"{p.Key}={p.Value}"))) · @(condition.Negate ? "must be false" : "must be true")</label>
                        }
                        <button class="btn btn-sm btn-outline-info my-2" @onclick="StartPreviewAsync">Restart preview</button>
                        <button class="btn btn-sm btn-outline-secondary ms-2" @onclick="() => _preview = null">Close preview</button>
                        @if (_previewError is not null) { <p class="text-warning small">@_previewError</p> }
                        @if (_preview.CurrentNode is { } previewNode)
                        {
                            <strong>@(previewNode.SpeakerTag ?? _editItem.SpeakerTag ?? "NPC")</strong>
                            <p class="mt-2" style="white-space:pre-wrap">@previewNode.Text</p>
                            @foreach (DialogueChoiceDto choice in _previewChoices)
                            { <button class="btn btn-sm btn-outline-light d-block mb-1" disabled="@_preview.IsBusy" @onclick="() => ChoosePreviewAsync(choice)">@(choice.IsContinue ? "Continue" : choice.ResponseText)</button> }
                            <button class="btn btn-sm btn-outline-secondary mt-2" @onclick="() => _preview = null">Goodbye</button>
                        }
                        @if (_previewActions.Count > 0) { <p class="small text-muted mt-2">Actions: @string.Join(" → ", _previewActions)</p> }
                    </fieldset>
                }
            </div>
        </div>
    }
</div>
