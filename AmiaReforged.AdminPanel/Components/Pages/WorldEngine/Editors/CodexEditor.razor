@code {
    // ═══════════════════════════════════════════════════════════════════
    //  Parameters
    // ═══════════════════════════════════════════════════════════════════

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnEntityListRefresh { get; set; }

    // ═══════════════════════════════════════════════════════════════════
    //  Public enum (shared with parent)
    // ═══════════════════════════════════════════════════════════════════

    public enum CodexSubType { Lore, Quest }

    // ═══════════════════════════════════════════════════════════════════
    //  State
    // ═══════════════════════════════════════════════════════════════════

    private const string GlInstanceId = "we-codex-editor";
    private bool _loading;
    private string? _editorError;

    private CodexSubType _subType = CodexSubType.Lore;
    private bool _isCreating;
    private bool _isSaving;
    private string? _error;
    private string? _success;

    // Lore edit state
    private LoreDefinitionDto _loreItem = new();

    // Quest edit state
    private QuestDefinitionDto _questItem = new();
    private int _newStageId = 10;
    private readonly HashSet<int> _expandedStageIds = [];
    private readonly HashSet<string> _expandedGroupKeys = [];
    private readonly HashSet<string> _expandedObjectiveKeys = [];
    private readonly HashSet<int> _expandedStageRewardIds = [];
    private bool _completionRewardExpanded;
    private List<IndustryDefinitionDto> _industries = [];
    private bool _industriesLoaded;

    // Graph editor overlay state
    private bool _graphEditorOpen;
    private string _graphEditorMode = "clue_graph";
    private int _graphEditorStageId;
    private int _graphEditorGroupIdx;
    private int _graphEditorObjIdx;

    // View menu
    private bool _showViewMenu;
    private readonly HashSet<string> _openPanels = ["ce-list", "ce-form", "ce-preview"];
    private static readonly Dictionary<string, string> PanelTitles = new()
    {
        ["ce-list"] = "Entity List",
        ["ce-form"] = "Data Editor Panel",
        ["ce-preview"] = "Preview",
    };

    // GL bridge refs
    private IJSObjectReference? _bridgeModule;
    private DotNetObjectReference<CodexEditor>? _dotNetRef;

    // Inner list state
    private string _listSearch = "";
    private bool _listLoading;
    private List<CeListEntry> _listItems = [];
    private CancellationTokenSource? _searchCts;

    private sealed class CeListEntry
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public string? SubLabel { get; set; }
        public CodexSubType SubType { get; set; }
        public bool IsSelected { get; set; }
    }

    // ═══════════════════════════════════════════════════════════════════
    //  Lifecycle
    // ═══════════════════════════════════════════════════════════════════

    public async Task OpenNewAsync(CodexSubType subType)
    {
        _loading = true;
        _editorError = null;
        _error = null;
        _success = null;
        _isCreating = true;
        _subType = subType;
        _loreItem = new LoreDefinitionDto();
        _questItem = new QuestDefinitionDto { Stages = [] };
        StateHasChanged();

        try
        {
            await CeLoadList();
            if (subType == CodexSubType.Quest) await CeEnsureIndustriesLoaded();
            StateHasChanged();
            await Task.Delay(50);

            await CeInitLayout();

            _loading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to open new codex editor");
            _editorError = $"Failed to load: {ex.Message}";
            _loading = false;
            StateHasChanged();
        }
    }

    public async Task OpenExistingAsync(string entityId, CodexSubType subType)
    {
        _loading = true;
        _editorError = null;
        _error = null;
        _success = null;
        _isCreating = false;
        _subType = subType;
        StateHasChanged();

        try
        {
            if (subType == CodexSubType.Lore)
            {
                LoreDefinitionDto? loaded = await LoreApi.GetByIdAsync(entityId);
                if (loaded == null)
                {
                    _editorError = $"Lore entry '{entityId}' not found.";
                    _loading = false;
                    StateHasChanged();
                    return;
                }
                _loreItem = loaded;
            }
            else
            {
                QuestDefinitionDto? loaded = await QuestApi.GetByIdAsync(entityId);
                if (loaded == null)
                {
                    _editorError = $"Quest entry '{entityId}' not found.";
                    _loading = false;
                    StateHasChanged();
                    return;
                }
                _questItem = loaded;
            }

            await CeLoadList();
            StateHasChanged();
            await Task.Delay(50);

            await CeInitLayout();

            _loading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to open codex editor for {Id}", entityId);
            _editorError = $"Failed to load: {ex.Message}";
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task CloseInternal()
    {
        try
        {
            if (_bridgeModule != null)
            {
                await _bridgeModule.InvokeVoidAsync("destroy", GlInstanceId);
            }
        }
        catch (Exception ex) { Logger.LogWarning(ex, "Error destroying Codex GL layout"); }

        _showViewMenu = false;
        _listItems = [];
        await OnClose.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_bridgeModule != null)
            {
                await _bridgeModule.InvokeVoidAsync("destroy", GlInstanceId);
                await _bridgeModule.DisposeAsync();
            }
        }
        catch { }
        _dotNetRef?.Dispose();
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }

    // ═══════════════════════════════════════════════════════════════════
    //  GL Layout
    // ═══════════════════════════════════════════════════════════════════

    private async Task CeInitLayout()
    {
        try
        {
            _bridgeModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/golden-layout-bridge.js");
            _dotNetRef ??= DotNetObjectReference.Create(this);

            string layoutConfig = CeBuildDefaultLayoutConfig();
            await _bridgeModule.InvokeVoidAsync("init", GlInstanceId, "we-codex-gl-container", layoutConfig, _dotNetRef);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to initialize Codex GL layout");
            _editorError = "Layout initialization failed. Try closing and reopening.";
        }
    }

    private static string CeBuildDefaultLayoutConfig()
    {
        var config = new
        {
            root = new
            {
                type = "row",
                content = new object[]
                {
                    new
                    {
                        type = "component",
                        componentType = "ce-form",
                        title = "Data Editor Panel",
                        size = "60%",
                    },
                    new
                    {
                        type = "column",
                        size = "40%",
                        content = new object[]
                        {
                            new
                            {
                                type = "component",
                                componentType = "ce-preview",
                                title = "Preview",
                                size = "50%",
                            },
                            new
                            {
                                type = "component",
                                componentType = "ce-list",
                                title = "Entity List",
                                size = "50%",
                            },
                        },
                    },
                },
            },
        };
        return JsonSerializer.Serialize(config);
    }

    // ═══════════════════════════════════════════════════════════════════
    //  View Menu & Panel Toggles
    // ═══════════════════════════════════════════════════════════════════

    private void CeToggleViewMenu() => _showViewMenu = !_showViewMenu;

    private async Task CeTogglePanel(string panelKey)
    {
        _showViewMenu = false;
        if (_openPanels.Contains(panelKey)) return;
        _openPanels.Add(panelKey);

        if (_bridgeModule != null)
        {
            try
            {
                string title = PanelTitles.GetValueOrDefault(panelKey, panelKey);
                await _bridgeModule.InvokeVoidAsync("addPanel", GlInstanceId, panelKey, title);
            }
            catch (Exception ex) { Logger.LogWarning(ex, "Failed to add CE panel {Panel}", panelKey); }
        }
        StateHasChanged();
    }

    private async Task CeResetLayout()
    {
        _showViewMenu = false;
        _openPanels.Clear();
        foreach (string key in PanelTitles.Keys) _openPanels.Add(key);

        if (_bridgeModule != null)
        {
            try
            {
                string layoutConfig = CeBuildDefaultLayoutConfig();
                await _bridgeModule.InvokeVoidAsync("loadLayout", GlInstanceId, layoutConfig);
            }
            catch (Exception ex) { Logger.LogWarning(ex, "Failed to reset CE layout"); }
        }
        StateHasChanged();
    }

    // ═══════════════════════════════════════════════════════════════════
    //  Save / Cancel / Delete
    // ═══════════════════════════════════════════════════════════════════

    private async Task CeSave()
    {
        _isSaving = true;
        _error = null;
        _success = null;
        StateHasChanged();

        try
        {
            if (_subType == CodexSubType.Lore)
            {
                if (_isCreating)
                    await LoreApi.CreateAsync(_loreItem);
                else
                    await LoreApi.UpdateAsync(_loreItem.LoreId, _loreItem);
                _success = _isCreating ? "Lore entry created." : "Lore entry updated.";
            }
            else
            {
                if (_isCreating)
                    await QuestApi.CreateAsync(_questItem);
                else
                    await QuestApi.UpdateAsync(_questItem.QuestId, _questItem);
                _success = _isCreating ? "Quest entry created." : "Quest entry updated.";
            }

            _isCreating = false;
            await CeLoadList();
            await OnEntityListRefresh.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Logger.LogError(ex, "Failed to save codex entry");
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private async Task CeCancel()
    {
        await CloseInternal();
    }

    private async Task CeDelete()
    {
        _error = null;
        _success = null;

        try
        {
            if (_subType == CodexSubType.Lore)
            {
                await LoreApi.DeleteAsync(_loreItem.LoreId);
                _success = "Lore entry deleted.";
            }
            else
            {
                await QuestApi.DeleteAsync(_questItem.QuestId);
                _success = "Quest entry deleted.";
            }

            _isCreating = true;
            _loreItem = new LoreDefinitionDto();
            _questItem = new QuestDefinitionDto { Stages = [] };
            await CeLoadList();
            await OnEntityListRefresh.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Logger.LogError(ex, "Failed to delete codex entry");
        }
        finally { StateHasChanged(); }
    }

    // ═══════════════════════════════════════════════════════════════════
    //  Entity List (inner panel)
    // ═══════════════════════════════════════════════════════════════════

    private async Task CeLoadList()
    {
        _listLoading = true;
        StateHasChanged();

        try
        {
            string? search = string.IsNullOrWhiteSpace(_listSearch) ? null : _listSearch.Trim();
            _listItems = [];

            if (_subType == CodexSubType.Lore)
            {
                PagedResult<LoreDefinitionDto> result = await LoreApi.GetAllAsync(search, page: 1, pageSize: 200);
                _listItems = result.Items.Select(i => new CeListEntry
                {
                    Id = i.LoreId, Title = i.Title,
                    SubLabel = i.CategoryName ?? $"Category {i.Category}",
                    SubType = CodexSubType.Lore,
                }).ToList();
            }
            else
            {
                PagedResult<QuestDefinitionDto> result = await QuestApi.GetAllAsync(search, page: 1, pageSize: 200);
                _listItems = result.Items.Select(i => new CeListEntry
                {
                    Id = i.QuestId, Title = i.Title,
                    SubLabel = i.QuestGiver ?? i.Location,
                    SubType = CodexSubType.Quest,
                }).ToList();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load codex entity list");
        }
        finally
        {
            _listLoading = false;
        }
    }

    private void CeSearchChanged()
    {
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        CancellationToken ct = _searchCts.Token;

        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(300, ct);
                if (!ct.IsCancellationRequested)
                {
                    await CeLoadList();
                    StateHasChanged();
                }
            }
            catch (TaskCanceledException) { }
        });
    }

    private async Task CeOnSubTypeChanged()
    {
        _listSearch = "";
        await CeLoadList();
        StateHasChanged();
    }

    private async Task CeSelectListItem(CeListEntry entry)
    {
        foreach (CeListEntry item in _listItems) item.IsSelected = false;
        entry.IsSelected = true;

        _isCreating = false;
        _error = null;
        _success = null;

        try
        {
            if (entry.SubType == CodexSubType.Lore)
            {
                _subType = CodexSubType.Lore;
                LoreDefinitionDto? loaded = await LoreApi.GetByIdAsync(entry.Id);
                if (loaded != null) _loreItem = loaded;
            }
            else
            {
                _subType = CodexSubType.Quest;
                QuestDefinitionDto? loaded = await QuestApi.GetByIdAsync(entry.Id);
                if (loaded != null) _questItem = loaded;
                await CeEnsureIndustriesLoaded();
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to load: {ex.Message}";
        }
        StateHasChanged();
    }

    // ═══════════════════════════════════════════════════════════════════
    //  Stage Helpers
    // ═══════════════════════════════════════════════════════════════════

    private void CeAddStage()
    {
        if (_questItem.Stages.Any(s => s.StageId == _newStageId)) return;
        _questItem.Stages.Add(new QuestStageDto
        {
            StageId = _newStageId,
            JournalText = "",
            IsCompletionStage = false,
            Hints = []
        });
        _expandedStageIds.Add(_newStageId);
        _newStageId = _questItem.Stages.Max(s => s.StageId) + 10;
    }

    private void CeRemoveStage(int stageId)
    {
        _questItem.Stages.RemoveAll(s => s.StageId == stageId);
        _expandedStageIds.Remove(stageId);
    }

    private void CeToggleStageExpand(int stageId)
    {
        if (!_expandedStageIds.Add(stageId))
            _expandedStageIds.Remove(stageId);
    }

    private int? CeComputeFallbackStageId(QuestStageDto stage)
    {
        return _questItem.Stages
            .Where(s => s.StageId > stage.StageId)
            .OrderBy(s => s.StageId)
            .FirstOrDefault()?.StageId;
    }

    private void CeAddHintToStage(int stageId)
    {
        var stage = _questItem.Stages.FirstOrDefault(s => s.StageId == stageId);
        stage?.Hints.Add("");
    }

    private void CeRemoveHintFromStage(int stageId, int hintIndex)
    {
        var stage = _questItem.Stages.FirstOrDefault(s => s.StageId == stageId);
        if (stage != null && hintIndex >= 0 && hintIndex < stage.Hints.Count)
            stage.Hints.RemoveAt(hintIndex);
    }

    public static string CeGetLoreCategoryName(int category) => category switch
    {
        0 => "General",
        1 => "History",
        2 => "Geography",
        3 => "Religion",
        4 => "Arcana",
        5 => "Nature",
        6 => "Faction",
        7 => "Character",
        8 => "Item",
        9 => "Quest",
        10 => "Miscellaneous",
        _ => $"Unknown ({category})"
    };

    public static string CeGetLoreTierName(int tier) => tier switch
    {
        0 => "Common",
        1 => "Uncommon",
        2 => "Rare",
        3 => "Legendary",
        _ => $"Unknown ({tier})"
    };

    // ═══════════════════════════════════════════════════════════════════
    //  Objective Group Helpers
    // ═══════════════════════════════════════════════════════════════════

    private void CeAddObjectiveGroup(int stageId)
    {
        QuestStageDto? stage = _questItem.Stages.FirstOrDefault(s => s.StageId == stageId);
        if (stage == null) return;
        stage.ObjectiveGroups.Add(new ObjectiveGroupDto
        {
            DisplayName = "",
            CompletionMode = "All",
            Objectives = []
        });
        string grpKey = $"{stageId}_{stage.ObjectiveGroups.Count - 1}";
        _expandedGroupKeys.Add(grpKey);
    }

    private void CeRemoveObjectiveGroup(int stageId, int groupIdx)
    {
        QuestStageDto? stage = _questItem.Stages.FirstOrDefault(s => s.StageId == stageId);
        if (stage != null && groupIdx >= 0 && groupIdx < stage.ObjectiveGroups.Count)
            stage.ObjectiveGroups.RemoveAt(groupIdx);
    }

    private void CeToggleGroupExpand(string grpKey)
    {
        if (!_expandedGroupKeys.Add(grpKey))
            _expandedGroupKeys.Remove(grpKey);
    }

    // ═══════════════════════════════════════════════════════════════════
    //  Objective Helpers
    // ═══════════════════════════════════════════════════════════════════

    private void CeAddObjective(int stageId, int groupIdx)
    {
        QuestStageDto? stage = _questItem.Stages.FirstOrDefault(s => s.StageId == stageId);
        if (stage == null || groupIdx < 0 || groupIdx >= stage.ObjectiveGroups.Count) return;

        ObjectiveGroupDto grp = stage.ObjectiveGroups[groupIdx];
        grp.Objectives.Add(new ObjectiveDefinitionDto
        {
            ObjectiveId = Guid.NewGuid().ToString("N")[..12],
            TypeTag = "kill",
            DisplayText = "",
            RequiredCount = 1
        });
        string objKey = $"{stageId}_{groupIdx}_{grp.Objectives.Count - 1}";
        _expandedObjectiveKeys.Add(objKey);
    }

    private void CeRemoveObjective(int stageId, int groupIdx, int objIdx)
    {
        QuestStageDto? stage = _questItem.Stages.FirstOrDefault(s => s.StageId == stageId);
        if (stage == null || groupIdx < 0 || groupIdx >= stage.ObjectiveGroups.Count) return;

        ObjectiveGroupDto grp = stage.ObjectiveGroups[groupIdx];
        if (objIdx >= 0 && objIdx < grp.Objectives.Count)
            grp.Objectives.RemoveAt(objIdx);
    }

    private void CeToggleObjectiveExpand(string objKey)
    {
        if (!_expandedObjectiveKeys.Add(objKey))
            _expandedObjectiveKeys.Remove(objKey);
    }

    // ═══════════════════════════════════════════════════════════════════
    //  Config Helpers
    // ═══════════════════════════════════════════════════════════════════

    public static string GetConfigString(ObjectiveDefinitionDto obj, string key, string fallback)
    {
        if (obj.Config != null && obj.Config.TryGetValue(key, out object? val) && val != null)
            return val.ToString() ?? fallback;
        return fallback;
    }

    public static void SetConfig(ObjectiveDefinitionDto obj, string key, string value)
    {
        obj.Config ??= new Dictionary<string, object>();
        obj.Config[key] = value;
    }

    // ═══════════════════════════════════════════════════════════════════
    //  Reward Helpers
    // ═══════════════════════════════════════════════════════════════════

    private void CeToggleStageRewardExpand(int stageId)
    {
        if (!_expandedStageRewardIds.Add(stageId))
            _expandedStageRewardIds.Remove(stageId);
    }

    // ═══════════════════════════════════════════════════════════════════
    //  Industry Cache
    // ═══════════════════════════════════════════════════════════════════

    private async Task CeEnsureIndustriesLoaded()
    {
        if (_industriesLoaded) return;
        try
        {
            PagedResult<IndustryDefinitionDto> result = await IndustryApi.GetAllAsync(pageSize: 500);
            _industries = result.Items?.ToList() ?? [];
            _industriesLoaded = true;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load industries for reward dropdown");
            _industries = [];
        }
    }

    // ═══════════════════════════════════════════════════════════════════
    //  Graph Editor
    // ═══════════════════════════════════════════════════════════════════

    private async Task CeOpenGraphEditor(int stageId, int groupIdx, int objIdx, string mode)
    {
        _graphEditorStageId = stageId;
        _graphEditorGroupIdx = groupIdx;
        _graphEditorObjIdx = objIdx;
        _graphEditorMode = mode;
        _graphEditorOpen = true;
        StateHasChanged();

        await Task.Delay(50);

        _dotNetRef ??= DotNetObjectReference.Create(this);

        ObjectiveDefinitionDto? obj = CeGetGraphEditorObjective();
        string existingJson = obj != null ? GetConfigString(obj, "graph_json", "{}") : "{}";

        if (mode == "clue_graph")
        {
            await JS.InvokeVoidAsync("clueGraphEditor.init", "ce-graph-canvas", existingJson, _dotNetRef);
        }
        else
        {
            await JS.InvokeVoidAsync("stateMachineEditor.init", "ce-graph-canvas", existingJson, _dotNetRef);
        }
    }

    private async Task CeCloseGraphEditor()
    {
        try
        {
            string json;
            if (_graphEditorMode == "clue_graph")
            {
                json = await JS.InvokeAsync<string>("clueGraphEditor.getGraphJson");
                await JS.InvokeVoidAsync("clueGraphEditor.destroy");
            }
            else
            {
                json = await JS.InvokeAsync<string>("stateMachineEditor.getGraphJson");
                await JS.InvokeVoidAsync("stateMachineEditor.destroy");
            }

            ObjectiveDefinitionDto? obj = CeGetGraphEditorObjective();
            if (obj != null && !string.IsNullOrWhiteSpace(json))
            {
                SetConfig(obj, "graph_json", json);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to save graph editor data");
        }

        _graphEditorOpen = false;
    }

    [JSInvokable]
    public void OnGraphChanged(string graphJson)
    {
        ObjectiveDefinitionDto? obj = CeGetGraphEditorObjective();
        if (obj != null)
        {
            SetConfig(obj, "graph_json", graphJson);
        }
    }

