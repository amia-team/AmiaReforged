    public void OnClueSelected(string clueJson) { }

    [JSInvokable]
    public void OnDeductionSelected(string deductionJson) { }

    [JSInvokable]
    public void OnStateSelected(string stateJson) { }

    [JSInvokable]
    public void OnTransitionSelected(string transitionJson) { }

    [JSInvokable]
    public void OnSelectionCleared(string _) { }

    private ObjectiveDefinitionDto? CeGetGraphEditorObjective()
    {
        QuestStageDto? stage = _questItem.Stages.FirstOrDefault(s => s.StageId == _graphEditorStageId);
        if (stage == null || _graphEditorGroupIdx < 0 || _graphEditorGroupIdx >= stage.ObjectiveGroups.Count)
            return null;
        ObjectiveGroupDto grp = stage.ObjectiveGroups[_graphEditorGroupIdx];
        if (_graphEditorObjIdx < 0 || _graphEditorObjIdx >= grp.Objectives.Count)
            return null;
        return grp.Objectives[_graphEditorObjIdx];
    }
}
