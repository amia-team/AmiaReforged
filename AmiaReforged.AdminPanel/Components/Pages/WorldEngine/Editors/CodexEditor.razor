@using AmiaReforged.AdminPanel.Models
@using AmiaReforged.AdminPanel.Services
@using System.Text.Json
@inject LoreApiService LoreApi
@inject QuestApiService QuestApi
@inject IndustryApiService IndustryApi
@inject ILogger<CodexEditor> Logger
@inject IJSRuntime JS

@* ══════ Codex Editor ══════ *@
<div class="we-editor__codex-editor-wrap" @onchange="CeContentChanged">
    @* ── Toolbar ── *@
    <div class="we-ce-toolbar">
        <h5 class="we-ce-toolbar__title">
            @if (_isCreating)
            {
                @($"New {_subType}")
            }
            else
            {
                @(_subType == CodexSubType.Lore ? _loreItem.Title : _questItem.Title)
            }
        </h5>
        <span class="badge" style="background:var(--bg-input);color:var(--text-secondary);font-size:0.75rem;font-weight:normal">
            @(_subType == CodexSubType.Lore ? "Lore" : "Quest")
        </span>
        <div class="we-ce-toolbar__divider"></div>
        <div style="flex:1"></div>
        @if (HasUnsavedChanges)
        {
            <span class="we-ce-draft-status" aria-live="polite">Unsaved changes</span>
        }
        @if (!string.IsNullOrEmpty(_error))
        {
            <span style="color:var(--danger);font-size:0.8rem;max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@_error">⚠ @_error</span>
        }
        @if (!string.IsNullOrEmpty(_success))
        {
            <span style="color:var(--success, #2ecc71);font-size:0.8rem">✓ @_success</span>
        }
        @if (CeCanDelete)
        {
            <button class="btn btn-sm btn-outline-danger" @onclick="() => _showDeleteConfirm = true" disabled="@(_isSaving || _isDeleting)">
                @(_isDeleting ? "Deleting…" : "Delete")
            </button>
        }
        <button class="btn btn-sm btn-secondary" @onclick="CeCancel" disabled="@(_isSaving || _isDeleting)">Cancel</button>
        <button class="btn btn-sm btn-primary" @onclick="CeSave" disabled="@(_isSaving || _isDeleting)">
            @(_isSaving ? "Saving…" : "Save")
        </button>
    </div>

    @if (_pendingLeave != null)
    {
        <div class="modal-backdrop">
            <div class="admin-modal we-ce-unsaved-dialog" role="dialog" aria-modal="true" aria-labelledby="ce-unsaved-title">
                <h3 id="ce-unsaved-title">Save your changes?</h3>
                <p>This entry has unsaved changes.</p>
                @if (!string.IsNullOrEmpty(_error))
                {
                    <p class="text-danger" role="alert">@_error</p>
                }
                <div style="display:flex;gap:10px;justify-content:flex-end;flex-wrap:wrap">
                    <button class="btn btn-secondary" disabled="@_isSaving" @onclick="() => _pendingLeave = null">Keep editing</button>
                    <button class="btn btn-outline-danger" disabled="@_isSaving" @onclick="CeDiscardAndContinue">Discard changes</button>
                    <button class="btn btn-primary" disabled="@_isSaving" @onclick="CeSaveAndContinue">Save and continue</button>
                </div>
            </div>
        </div>
    }

    @if (_showDeleteConfirm)
    {
        <div class="modal-backdrop" @onclick="() => _showDeleteConfirm = false">
            <div class="admin-modal" role="dialog" aria-modal="true" aria-labelledby="ce-delete-title"
                 @onclick:stopPropagation="true" style="max-width:450px;margin:15vh auto;background:var(--bg-card);border-radius:12px;padding:30px">
                <h3 id="ce-delete-title">Confirm Delete</h3>
                <p>Delete @(_subType == CodexSubType.Lore ? "lore" : "quest") entry
                    <strong>@(_subType == CodexSubType.Lore ? _loreItem.Title : _questItem.Title)</strong>
                    (<code>@(_subType == CodexSubType.Lore ? _loreItem.LoreId : _questItem.QuestId)</code>)?</p>
                <p>This action cannot be undone.</p>
                @if (_subType == CodexSubType.Lore)
                {
                    <p>Associated lore unlock records will also be deleted.</p>
                }
                <div style="display:flex;gap:10px;justify-content:flex-end">
                    <button class="btn btn-secondary" @onclick="() => _showDeleteConfirm = false">Cancel</button>
                    <button class="btn btn-danger" @onclick="CeDelete">Delete</button>
                </div>
            </div>
        </div>
    }

    @if (_loading)
    {
        <div class="we-ce-loading-overlay">
            <span class="spinner-border spinner-border-sm me-2"></span>
            <span>Loading codex editor…</span>
        </div>
    }
    else if (_editorError != null)
    {
        <div class="we-editor__tab-error">
            <span class="bi bi-exclamation-triangle me-1"></span> @_editorError
        </div>
    }

    @{ RenderFragment entityBrowser = @<text>
@* ── Entity List ── *@
        <div class="we-ce-entity-browser" style="min-height:0">
            <div style="background:var(--bg-card);display:flex;flex-direction:column">
                <div style="padding:8px 12px;border-bottom:1px solid var(--border-subtle);flex-shrink:0;display:flex;gap:6px;align-items:center">
                    <select class="form-control form-control-sm" style="font-size:0.8rem;flex:0 0 auto;width:auto"
                            disabled="@(_isSaving || _isDeleting)"
                            @bind:get="_subType" @bind:set="CeOnSubTypeChanged" aria-label="Entry type">
                        <option value="@CodexSubType.Lore">Lore</option>
                        <option value="@CodexSubType.Quest">Quests</option>
                    </select>
                    <input type="text" class="form-control form-control-sm" placeholder="Search..."
                           @bind="_listSearch" @bind:event="oninput" @bind:after="CeSearchChanged"
                           style="font-size:0.8rem;flex:1" />
                </div>
                <div style="flex:1;overflow-y:auto">
                    @if (_listLoading)
                    {
                        <div style="padding:12px;text-align:center;color:var(--text-secondary)">
                            <span class="spinner-border spinner-border-sm me-1"></span> Loading…
                        </div>
                    }
                    else if (_listItems.Count == 0)
                    {
                        <div style="padding:12px;color:var(--text-secondary);font-size:0.8rem;text-align:center">
                            No entries found.
                        </div>
                    }
                    else
                    {
                        @foreach (CeListEntry entry in _listItems)
                        {
                            <button type="button" style="padding:6px 12px;border:0;border-bottom:1px solid var(--border-subtle);width:100%;text-align:left;background:transparent;font-size:0.82rem"
                                 class="@(entry.IsSelected ? "bg-primary bg-opacity-25" : "")"
                                 @onclick="() => CeSelectListItem(entry)">
                                <span style="color:var(--text-primary)">@entry.Title</span>
                                @if (!string.IsNullOrEmpty(entry.SubLabel))
                                {
                                    <br /><small style="color:var(--text-secondary)">@entry.SubLabel</small>
                                }
                            </button>
                        }
                    }
                </div>
            </div>
    </div>
    </text>; }

    @* ── Layout area: list | form | preview splits ── *@
    <div class="we-ce-layout-area">
    @if (_subType == CodexSubType.Quest)
    {
        <QuestWorkspace @ref="_questWorkspace" Model="@_questItem" IsCreating="@_isCreating"
                        ReadOnly="@(_isSaving || _isDeleting)" Industries="@_industries" Browser="@entityBrowser"
                        Changed="CeContentChanged"
                        GraphEditorRequested="args => CeOpenGraphEditor(args.StageId, args.GroupIndex, args.ObjectiveIndex, args.Mode)" />
    }
    else
    {
    <ResizableSplit Direction="horizontal" FirstDefaultWidth="260" FirstMin="200" SecondMin="600"
                    PersistKey="codex-list" CollapsibleFirst="true" CollapsibleSecond="false">
        <First>
        @entityBrowser
        </First>
        <Second>
            <ResizableSplit Direction="horizontal" FirstDefaultWidth="340" FirstMin="260" SecondMin="400"
                            PersistKey="codex-preview" SwapOrder="true"
                            CollapsibleFirst="true" CollapsibleSecond="false">
                <Second>
        @* ── Form / Editor ── *@
            <div style="background:var(--bg-card);padding:12px;min-height:100%;overflow-y:auto">
                @if (_subType == CodexSubType.Lore)
                {
                    @* Lore form *@
                    <h5 style="margin:0 0 10px 0;font-size:0.9rem">Lore Entry</h5>

                    <div class="form-group" style="margin-bottom:8px">
                        <label style="font-size:0.8rem">Lore ID</label>
                        <input class="form-control form-control-sm" @bind="_loreItem.LoreId" disabled="@(!_isCreating)" placeholder="e.g. lore_ancient_ruins" />
                    </div>
                    <div class="form-group" style="margin-bottom:8px">
                        <label style="font-size:0.8rem">Title</label>
                        <input class="form-control form-control-sm" @bind="_loreItem.Title" placeholder="e.g. The Ancient Ruins" />
                    </div>
                    <div class="form-group" style="margin-bottom:8px">
                        <label style="font-size:0.8rem">Content</label>
                        <textarea class="form-control form-control-sm" rows="8" @bind="_loreItem.Content" placeholder="Lore content..."></textarea>
                    </div>
                    <div style="display:flex;gap:8px;margin-bottom:8px">
                        <div class="form-group" style="flex:1">
                            <label style="font-size:0.8rem">Category</label>
                            <select class="form-control form-control-sm" @bind="_loreItem.Category">
                                @foreach (var category in LoreCategoryNames)
                                {
                                    <option value="@category.Key">@category.Value</option>
                                }
                            </select>
                        </div>
                        <div class="form-group" style="flex:1">
                            <label style="font-size:0.8rem">Tier</label>
                            <select class="form-control form-control-sm" @bind="_loreItem.Tier">
                                <option value="0">Common</option>
                                <option value="1">Uncommon</option>
                                <option value="2">Rare</option>
                                <option value="3">Legendary</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group" style="margin-bottom:8px">
                        <label style="font-size:0.8rem">Keywords</label>
                        <input class="form-control form-control-sm" @bind="_loreItem.Keywords" placeholder="Comma-separated keywords" />
                    </div>
                    <div class="form-check" style="margin-bottom:8px">
                        <input type="checkbox" class="form-check-input" id="ceLoreAlwaysAvailable" @bind="_loreItem.IsAlwaysAvailable" />
                        <label class="form-check-label" for="ceLoreAlwaysAvailable" style="font-size:0.8rem">Always Available</label>
                    </div>
                }
            </div>
                </Second>
                <First>
        @* ── Preview ── *@
        <div style="height:100%;min-height:0;overflow-y:auto">
            <div style="background:var(--bg-card);padding:12px;min-height:100%;overflow-y:auto">
                <h5 style="margin:0 0 10px 0;font-size:0.9rem">Preview</h5>
                @if (_subType == CodexSubType.Lore)
                {
                    <div class="we-entity-form">
                        <div class="we-entity-form__field"><label>Lore ID</label><span>@_loreItem.LoreId</span></div>
                        <div class="we-entity-form__field"><label>Title</label><span>@_loreItem.Title</span></div>
                        <div class="we-entity-form__field"><label>Category</label><span>@CeGetLoreCategoryName(_loreItem.Category)</span></div>
                        <div class="we-entity-form__field"><label>Tier</label><span>@CeGetLoreTierName(_loreItem.Tier)</span></div>
                        <div class="we-entity-form__field"><label>Keywords</label><span>@(_loreItem.Keywords ?? "—")</span></div>
                        <div class="we-entity-form__field"><label>Always Available</label><span>@(_loreItem.IsAlwaysAvailable ? "Yes" : "No")</span></div>
                        @if (!string.IsNullOrEmpty(_loreItem.Content))
                        {
                            <div style="margin-top:8px;padding:8px;background:var(--bg-input);border-radius:4px;font-size:0.82rem;white-space:pre-wrap;max-height:400px;overflow-y:auto">
                                @_loreItem.Content
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
                </First>
            </ResizableSplit>
        </Second>
    </ResizableSplit>
    }
    </div> @* end we-ce-layout-area *@

    @* ── Graph Editor Overlay (ClueGraph / StateMachine) ── *@
    @if (_graphEditorOpen)
    {
        ObjectiveDefinitionDto? graphObj = CeGetGraphEditorObjective();
        <div style="position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,0.85);display:flex;flex-direction:column">
            @* Toolbar *@
            <div style="display:flex;align-items:center;gap:8px;padding:8px 16px;background:var(--bg-card);border-bottom:1px solid var(--border-subtle)">
                <span style="font-weight:700;font-size:0.9rem;color:var(--accent,#c9a84c)">
                    @(_graphEditorMode == "clue_graph" ? "Clue Graph Editor" : "State Machine Editor")
                </span>
                @if (graphObj != null)
                {
                    <span style="font-size:0.78rem;color:var(--text-secondary)">— @graphObj.DisplayText</span>
                }
                <span style="flex:1"></span>
                <button class="btn btn-sm btn-outline-secondary" style="font-size:0.75rem"
                        @onclick="CeCloseGraphEditor">Done</button>
            </div>
            @* Body — Canvas + Sidebar *@
            <div style="flex:1;display:flex;overflow:hidden">
                @* Canvas *@
                <div style="flex:1;position:relative">
                    <div id="ce-graph-canvas" style="width:100%;height:100%"></div>
                </div>
                @* Sidebar property panel *@
                <div style="width:280px;background:var(--bg-card);border-left:1px solid var(--border-subtle);overflow-y:auto;padding:12px">
                    @if (_graphEditorMode == "clue_graph")
                    {
                        <h6 style="font-size:0.82rem;margin:0 0 8px 0">Clue Graph Properties</h6>
                        <p style="font-size:0.72rem;color:var(--text-secondary)">
                            Click nodes to select clues. Click edges to select deductions.
                            Double-click canvas to add a clue. Right-click for context menu.
                        </p>
                        <div id="ce-graph-sidebar-clue" style="display:none">
                            <div class="form-group" style="margin-bottom:6px">
                                <label style="font-size:0.7rem">Clue Name</label>
                                <input class="form-control form-control-sm" id="ce-graph-clue-name" style="font-size:0.78rem" />
                            </div>
                            <div class="form-group" style="margin-bottom:6px">
                                <label style="font-size:0.7rem">Trigger Tag</label>
                                <input class="form-control form-control-sm" id="ce-graph-clue-trigger" style="font-size:0.78rem" />
                            </div>
                        </div>
                        <div id="ce-graph-sidebar-deduction" style="display:none">
                            <div class="form-group" style="margin-bottom:6px">
                                <label style="font-size:0.7rem">Required Clues</label>
                                <div id="ce-graph-deduction-required" style="font-size:0.75rem"></div>
                            </div>
                            <div class="form-group" style="margin-bottom:6px">
                                <label style="font-size:0.7rem">Unlocks Clues</label>
                                <div id="ce-graph-deduction-unlocks" style="font-size:0.75rem"></div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <h6 style="font-size:0.82rem;margin:0 0 8px 0">State Machine Properties</h6>
                        <p style="font-size:0.72rem;color:var(--text-secondary)">
                            Drag to move states. Drag from a state edge to create a transition.
                            Double-click canvas to add a state. Right-click → set initial/terminal.
                        </p>
                        <div id="ce-graph-sidebar-state" style="display:none">
                            <div class="form-group" style="margin-bottom:6px">
                                <label style="font-size:0.7rem">State ID</label>
                                <input class="form-control form-control-sm" id="ce-graph-state-id" style="font-size:0.78rem" />
                            </div>
                            <div class="form-group" style="margin-bottom:6px">
                                <label style="font-size:0.7rem">Description</label>
                                <textarea class="form-control form-control-sm" rows="2" id="ce-graph-state-desc" style="font-size:0.78rem"></textarea>
                            </div>
                            <div class="form-check" style="margin-bottom:4px">
                                <input type="checkbox" class="form-check-input" id="ce-graph-state-terminal-success" />
                                <label class="form-check-label" for="ce-graph-state-terminal-success" style="font-size:0.72rem">Terminal Success</label>
                            </div>
                            <div class="form-check" style="margin-bottom:4px">
                                <input type="checkbox" class="form-check-input" id="ce-graph-state-terminal-failure" />
                                <label class="form-check-label" for="ce-graph-state-terminal-failure" style="font-size:0.72rem">Terminal Failure</label>
                            </div>
                        </div>
                        <div id="ce-graph-sidebar-transition" style="display:none">
                            <div class="form-group" style="margin-bottom:6px">
                                <label style="font-size:0.7rem">Signal Type</label>
                                <select class="form-select form-select-sm" id="ce-graph-trans-signal" style="font-size:0.78rem">
                                    <option value="creature_killed">Creature Killed</option>
                                    <option value="item_acquired">Item Acquired</option>
                                    <option value="item_lost">Item Lost</option>
                                    <option value="area_entered">Area Entered</option>
                                    <option value="area_exited">Area Exited</option>
                                    <option value="dialog_choice">Dialog Choice</option>
                                    <option value="clue_found">Clue Found</option>
                                    <option value="npc_status_changed">NPC Status Changed</option>
                                    <option value="waypoint_reached">Waypoint Reached</option>
                                    <option value="custom">Custom</option>
                                </select>
                            </div>
                            <div class="form-group" style="margin-bottom:6px">
                                <label style="font-size:0.7rem">Target Tag</label>
                                <input class="form-control form-control-sm" id="ce-graph-trans-target" style="font-size:0.78rem" />
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    // ═══════════════════════════════════════════════════════════════════
    //  Parameters
    // ═══════════════════════════════════════════════════════════════════

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnEntityListRefresh { get; set; }
    [Parameter] public EventCallback<bool> OnDirtyChanged { get; set; }

    /// <summary>
    /// Tab-mode entry point. When <see cref="OpenOnParameters"/> is true the
    /// editor auto-opens for <see cref="EntityKey"/> (or a blank new entry
    /// when null) instead of waiting for an imperative
    /// <c>OpenNewAsync</c>/<c>OpenExistingAsync</c> call.
    /// </summary>
    [Parameter] public string? EntityKey { get; set; }
    [Parameter] public CodexSubType InitialSubType { get; set; } = CodexSubType.Lore;
    [Parameter] public bool OpenOnParameters { get; set; }
    [Parameter] public bool IsActive { get; set; } = true;

    // ═══════════════════════════════════════════════════════════════════
    //  Public enum (shared with parent)
    // ═══════════════════════════════════════════════════════════════════

    public enum CodexSubType { Lore, Quest }

    // ═══════════════════════════════════════════════════════════════════
    //  State
    // ═══════════════════════════════════════════════════════════════════

    private bool _loading;
    private string? _editorError;

    private CodexSubType _subType = CodexSubType.Lore;
    private bool _isCreating;
    private bool _isSaving;
    private bool _isDeleting;
    private bool _showDeleteConfirm;
    private string? _error;
    private string? _success;
    private string? _savedSnapshot;
    private Func<Task>? _pendingLeave;
    private QuestWorkspace? _questWorkspace;

    public bool HasUnsavedChanges => _savedSnapshot != null &&
        (CeSnapshot() != _savedSnapshot || (_subType == CodexSubType.Quest && _questWorkspace?.HasInvalidInput == true));
    public bool IsBusy => _isSaving || _isDeleting;
    public string CurrentTitle => _subType == CodexSubType.Quest ? _questItem.Title : _loreItem.Title;

    private string CeSnapshot() => _subType == CodexSubType.Quest
        ? JsonSerializer.Serialize(_questItem) : JsonSerializer.Serialize(_loreItem);

    private async Task CeContentChanged()
    {
        _success = null;
        await OnDirtyChanged.InvokeAsync(HasUnsavedChanges);
    }

    public Task RequestCloseAsync() => RequestLeaveAsync(CloseInternal);

    public async Task RequestLeaveAsync(Func<Task> continuation)
    {
        if (IsBusy) return;
        if (!HasUnsavedChanges) { await continuation(); return; }
        _pendingLeave = continuation;
        StateHasChanged();
    }

    private async Task CeDiscardAndContinue()
    {
        Func<Task>? continuation = _pendingLeave;
        _pendingLeave = null;
        if (_savedSnapshot != null)
        {
            if (_subType == CodexSubType.Quest)
                _questItem = JsonSerializer.Deserialize<QuestDefinitionDto>(_savedSnapshot)!;
            else
                _loreItem = JsonSerializer.Deserialize<LoreDefinitionDto>(_savedSnapshot)!;
        }
        _questWorkspace = null;
        await OnDirtyChanged.InvokeAsync(false);
        if (continuation != null) await continuation();
    }

    private async Task CeSaveAndContinue()
    {
        if (!await CeTrySave()) return;
        Func<Task>? continuation = _pendingLeave;
        _pendingLeave = null;
        if (continuation != null) await continuation();
    }

    private bool CeCanDelete => !_isCreating && !_loading && _editorError == null
        && !string.IsNullOrWhiteSpace(_subType == CodexSubType.Lore ? _loreItem.LoreId : _questItem.QuestId);

    // Lore edit state
    private LoreDefinitionDto _loreItem = new();

    // Quest edit state
    private QuestDefinitionDto _questItem = new();
    private List<IndustryDefinitionDto> _industries = [];
    private bool _industriesLoaded;

    // Graph editor overlay state
    private bool _graphEditorOpen;
    private string _graphEditorMode = "clue_graph";
    private int _graphEditorStageId;
    private int _graphEditorGroupIdx;
    private int _graphEditorObjIdx;

    // JS interop refs (graph editors)
    private DotNetObjectReference<CodexEditor>? _dotNetRef;

    // Inner list state
    private string _listSearch = "";
    private bool _listLoading;
    private List<CeListEntry> _listItems = [];
    private CancellationTokenSource? _searchCts;

    private sealed class CeListEntry
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public string? SubLabel { get; set; }
        public CodexSubType SubType { get; set; }
        public bool IsSelected { get; set; }
    }

    // ═══════════════════════════════════════════════════════════════════
    //  Lifecycle
    // ═══════════════════════════════════════════════════════════════════

    // Tab-mode auto-open tracking (see OpenOnParameters).
    private bool _autoOpened;
    private string? _autoOpenedKey;
    private bool _autoOpenedIsNew;
    private CodexSubType _autoOpenedSubType;

    protected override async Task OnParametersSetAsync()
    {
        if (!IsActive && _graphEditorOpen) await CeCloseGraphEditor();
        if (!OpenOnParameters) return;

        bool isNew = EntityKey is null;
        if (_autoOpened && _autoOpenedKey == EntityKey && _autoOpenedIsNew == isNew
            && _autoOpenedSubType == InitialSubType) return;

        _autoOpened = true;
        _autoOpenedKey = EntityKey;
        _autoOpenedIsNew = isNew;
        _autoOpenedSubType = InitialSubType;

        if (isNew)
            await OpenNewAsync(InitialSubType);
        else
            await OpenExistingAsync(EntityKey!, InitialSubType);
    }

    public Task OpenNewAsync(CodexSubType subType) => RequestLeaveAsync(() => CeOpenNewAsync(subType));

    private async Task CeOpenNewAsync(CodexSubType subType)
    {
        _showDeleteConfirm = false;
        _loading = true;
        _editorError = null;
        _error = null;
        _success = null;
        _isCreating = true;
        _subType = subType;
        _loreItem = new LoreDefinitionDto();
        _questItem = new QuestDefinitionDto { Stages = [] };
        _savedSnapshot = CeSnapshot();
        await OnDirtyChanged.InvokeAsync(false);
        StateHasChanged();

        try
        {
            await CeLoadList();
            if (subType == CodexSubType.Quest) await CeEnsureIndustriesLoaded();
            StateHasChanged();

            _loading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to open new codex editor");
            _editorError = $"Failed to load: {ex.Message}";
            _loading = false;
            StateHasChanged();
        }
    }

    public Task OpenExistingAsync(string entityId, CodexSubType subType) => RequestLeaveAsync(() => CeOpenExistingAsync(entityId, subType));

    private async Task CeOpenExistingAsync(string entityId, CodexSubType subType)
    {
        _showDeleteConfirm = false;
        _loading = true;
        _editorError = null;
        _error = null;
        _success = null;
        _isCreating = false;
        _subType = subType;
        _savedSnapshot = null;
        StateHasChanged();

        try
        {
            if (subType == CodexSubType.Lore)
            {
                LoreDefinitionDto? loaded = await LoreApi.GetByIdAsync(entityId);
                if (loaded == null)
                {
                    _editorError = $"Lore entry '{entityId}' not found.";
                    _loading = false;
                    StateHasChanged();
                    return;
                }
                _loreItem = loaded;
            }
            else
            {
                QuestDefinitionDto? loaded = await QuestApi.GetByIdAsync(entityId);
                if (loaded == null)
                {
                    _editorError = $"Quest entry '{entityId}' not found.";
                    _loading = false;
                    StateHasChanged();
                    return;
                }
                _questItem = loaded;
                await CeEnsureIndustriesLoaded();
            }

            _savedSnapshot = CeSnapshot();
            await OnDirtyChanged.InvokeAsync(false);

            await CeLoadList();
            StateHasChanged();

            _loading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to open codex editor for {Id}", entityId);
            _editorError = $"Failed to load: {ex.Message}";
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task CloseInternal()
    {
        _listItems = [];
        await OnClose.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        await Task.CompletedTask;
    }

    // ═══════════════════════════════════════════════════════════════════
    //  Save / Cancel / Delete
    // ═══════════════════════════════════════════════════════════════════

    private async Task CeSave() => await CeTrySave();

    private async Task<bool> CeTrySave()
    {
        if (IsBusy || _loading || _editorError != null) return false;
        if (_subType == CodexSubType.Quest &&
            (QuestDefinitionValidator.Validate(_questItem).Count > 0 || _questWorkspace?.HasInvalidInput == true))
        {
            _questWorkspace?.ShowErrors();
            _error = "Resolve the quest validation issues before saving.";
            return false;
        }
        _isSaving = true;
        _error = null;
        _success = null;
        StateHasChanged();

        try
        {
            if (_subType == CodexSubType.Lore)
            {
                if (_isCreating)
                    await LoreApi.CreateAsync(_loreItem);
                else
                    await LoreApi.UpdateAsync(_loreItem.LoreId, _loreItem);
                _success = _isCreating ? "Lore entry created." : "Lore entry updated.";
            }
            else
            {
                QuestDefinitionDto? saved;
                if (_isCreating)
                    saved = await QuestApi.CreateAsync(_questItem);
                else
                    saved = await QuestApi.UpdateAsync(_questItem.QuestId, _questItem);
                if (saved != null)
                {
                    _questItem.QuestId = saved.QuestId;
                    _questItem.Title = saved.Title;
                }
                _success = _isCreating ? "Quest entry created." : "Quest entry updated.";
            }

            _isCreating = false;
            _savedSnapshot = CeSnapshot();
            await OnDirtyChanged.InvokeAsync(false);
            await CeLoadList();
            await OnEntityListRefresh.InvokeAsync();
            return true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Logger.LogError(ex, "Failed to save codex entry");
            return false;
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private async Task CeCancel()
    {
        await RequestCloseAsync();
    }

    private async Task CeDelete()
    {
        if (!CeCanDelete || !_showDeleteConfirm || _isSaving || _isDeleting) return;

        _showDeleteConfirm = false;
        _isDeleting = true;
        _error = null;
        _success = null;
        StateHasChanged();

        try
        {
            if (_subType == CodexSubType.Lore)
            {
                await LoreApi.DeleteAsync(_loreItem.LoreId);
                _success = "Lore entry deleted.";
            }
            else
            {
                await QuestApi.DeleteAsync(_questItem.QuestId);
                _success = "Quest entry deleted.";
            }

            _isCreating = true;
            _loreItem = new LoreDefinitionDto();
            _questItem = new QuestDefinitionDto { Stages = [] };
            _savedSnapshot = CeSnapshot();
            await OnDirtyChanged.InvokeAsync(false);
            await CeLoadList();
            await OnEntityListRefresh.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Logger.LogError(ex, "Failed to delete codex entry");
        }
        finally
        {
            _isDeleting = false;
            StateHasChanged();
        }
    }

    // ═══════════════════════════════════════════════════════════════════
    //  Entity List (inner panel)
    // ═══════════════════════════════════════════════════════════════════

    private async Task CeLoadList()
    {
        _listLoading = true;
        StateHasChanged();

        try
        {
            string? search = string.IsNullOrWhiteSpace(_listSearch) ? null : _listSearch.Trim();
            _listItems = [];

            if (_subType == CodexSubType.Lore)
            {
                PagedResult<LoreDefinitionDto> result = await LoreApi.GetAllAsync(search, page: 1, pageSize: 200);
                _listItems = result.Items.Select(i => new CeListEntry
                {
                    Id = i.LoreId, Title = i.Title,
                    SubLabel = i.CategoryName ?? $"Category {i.Category}",
                    SubType = CodexSubType.Lore,
                }).ToList();
            }
            else
            {
                PagedResult<QuestDefinitionDto> result = await QuestApi.GetAllAsync(search, page: 1, pageSize: 200);
                _listItems = result.Items.Select(i => new CeListEntry
                {
                    Id = i.QuestId, Title = i.Title,
                    SubLabel = i.QuestGiver ?? i.Location,
                    SubType = CodexSubType.Quest,
                }).ToList();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load codex entity list");
        }
        finally
        {
            _listLoading = false;
        }
    }

    private void CeSearchChanged()
    {
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        CancellationToken ct = _searchCts.Token;

        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(300, ct);
                if (!ct.IsCancellationRequested)
                {
                    await CeLoadList();
                    StateHasChanged();
                }
            }
            catch (TaskCanceledException) { }
        });
    }

    private Task CeOnSubTypeChanged(CodexSubType subType)
        => RequestLeaveAsync(async () => { _listSearch = ""; await CeOpenNewAsync(subType); });

    private async Task CeSelectListItem(CeListEntry entry)
        => await RequestLeaveAsync(() => CeLoadListItem(entry));

    private async Task CeLoadListItem(CeListEntry entry)
    {
        if (_isSaving || _isDeleting) return;

        _showDeleteConfirm = false;
        _loading = true;
        _editorError = null;
        foreach (CeListEntry item in _listItems) item.IsSelected = false;
        entry.IsSelected = true;

        _isCreating = false;
        _error = null;
        _success = null;

        try
        {
            if (entry.SubType == CodexSubType.Lore)
            {
                _subType = CodexSubType.Lore;
                LoreDefinitionDto? loaded = await LoreApi.GetByIdAsync(entry.Id);
                _loreItem = loaded ?? throw new InvalidOperationException($"Lore entry '{entry.Id}' not found.");
            }
            else
            {
                _subType = CodexSubType.Quest;
                QuestDefinitionDto? loaded = await QuestApi.GetByIdAsync(entry.Id);
                _questItem = loaded ?? throw new InvalidOperationException($"Quest entry '{entry.Id}' not found.");
                await CeEnsureIndustriesLoaded();
            }
            _savedSnapshot = CeSnapshot();
            await OnDirtyChanged.InvokeAsync(false);
        }
        catch (Exception ex)
        {
            _editorError = $"Failed to load: {ex.Message}";
        }
        _loading = false;
        StateHasChanged();
    }

