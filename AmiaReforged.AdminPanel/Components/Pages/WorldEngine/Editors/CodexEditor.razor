    private async Task CeEnsureIndustriesLoaded()
    {
        if (_industriesLoaded) return;
        try
        {
            PagedResult<IndustryDefinitionDto> result = await IndustryApi.GetAllAsync(pageSize: 500);
            _industries = result.Items?.ToList() ?? [];
            _industriesLoaded = true;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load industries for reward dropdown");
            _industries = [];
        }
    }

    // ═══════════════════════════════════════════════════════════════════
    //  Graph Editor
    // ═══════════════════════════════════════════════════════════════════

    private async Task CeOpenGraphEditor(int stageId, int groupIdx, int objIdx, string mode)
    {
        _graphEditorStageId = stageId;
        _graphEditorGroupIdx = groupIdx;
        _graphEditorObjIdx = objIdx;
        _graphEditorMode = mode;
        _graphEditorOpen = true;
        StateHasChanged();

        await Task.Delay(50);

        _dotNetRef ??= DotNetObjectReference.Create(this);

        ObjectiveDefinitionDto? obj = CeGetGraphEditorObjective();
        string existingJson = obj != null ? GetConfigString(obj, "graph_json", "{}") : "{}";

        if (mode == "clue_graph")
        {
            await JS.InvokeVoidAsync("clueGraphEditor.init", "ce-graph-canvas", existingJson, _dotNetRef);
        }
        else
        {
            await JS.InvokeVoidAsync("stateMachineEditor.init", "ce-graph-canvas", existingJson, _dotNetRef);
        }
    }

    private async Task CeCloseGraphEditor()
    {
        try
        {
            string json;
            if (_graphEditorMode == "clue_graph")
            {
                json = await JS.InvokeAsync<string>("clueGraphEditor.getGraphJson");
                await JS.InvokeVoidAsync("clueGraphEditor.destroy");
            }
            else
            {
                json = await JS.InvokeAsync<string>("stateMachineEditor.getGraphJson");
                await JS.InvokeVoidAsync("stateMachineEditor.destroy");
            }

            ObjectiveDefinitionDto? obj = CeGetGraphEditorObjective();
            if (obj != null && !string.IsNullOrWhiteSpace(json))
            {
                SetConfig(obj, "graph_json", json);
                _questWorkspace?.RefreshConfiguration(obj);
                await CeContentChanged();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to save graph editor data");
        }

        _graphEditorOpen = false;
    }

    [JSInvokable]
    public Task OnGraphChanged(string graphJson) => InvokeAsync(async () =>
    {
        ObjectiveDefinitionDto? obj = CeGetGraphEditorObjective();
        if (obj != null)
        {
            SetConfig(obj, "graph_json", graphJson);
            _questWorkspace?.RefreshConfiguration(obj);
            await CeContentChanged();
            StateHasChanged();
        }
    });

