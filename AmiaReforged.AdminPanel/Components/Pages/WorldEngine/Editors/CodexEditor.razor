    public static string GetConfigString(ObjectiveDefinitionDto obj, string key, string fallback)
    {
        if (obj.Config != null && obj.Config.TryGetValue(key, out object? val) && val != null)
            return val.ToString() ?? fallback;
        return fallback;
    }

    public static void SetConfig(ObjectiveDefinitionDto obj, string key, string value)
    {
        obj.Config ??= new Dictionary<string, object>();
        obj.Config[key] = value;
    }

