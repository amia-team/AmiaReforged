@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="glyph-code-host" @ref="_host"></div>
@if (!_ready)
{
    <textarea aria-label="Glyph source" class="form-control" rows="18" spellcheck="false"
              style="font-family:monospace;tab-size:4" value="@_source" @oninput="FallbackChanged"
              disabled="@(ReadOnly || !_attempted)"></textarea>
}
@if (_failed)
{
    <p role="status">The code editor could not load. You can continue editing in the text field.</p>
}

@code {
    // Re-key this component when loading another document or replacing its source.
    [Parameter] public string InitialSource { get; set; } = "";
    [Parameter] public EventCallback<string> SourceChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public GlyphLanguageMetadataDto? Metadata { get; set; }
    [Parameter] public IReadOnlyList<GlyphDiagnosticDto> Diagnostics { get; set; } = [];
    [Parameter] public string DiagnosticSource { get; set; } = "";
    [Parameter] public EventCallback<GlyphCursorContextDto> CursorContextChanged { get; set; }
    [Parameter] public EventCallback<bool> ReadyChanged { get; set; }
    [Parameter] public EventCallback<string> DocumentationRequested { get; set; }
    public bool CanInsert => _ready && !_disposed && !ReadOnly;
    private long _contextRevision;
    private GlyphLanguageMetadataDto? _sentMetadata;
    private IReadOnlyList<GlyphDiagnosticDto>? _sentDiagnostics;
    private string? _sentDiagnosticSource;
    private ElementReference _host;
    private IJSObjectReference? _module;
    private DotNetObjectReference<GlyphCodeEditor>? _callback;
    private string _source = "";
    private long _revision;
    private bool _attempted, _ready, _failed, _disposed;

    protected override void OnInitialized() => _source = InitialSource;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (!_attempted)
        {
            _attempted = true;
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/glyph-editor.js?v=7");
                if (_disposed) { await ReleaseAsync(); return; }
                _callback = DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync("create", _host, _callback, _source, ReadOnly);
                if (_disposed) { await ReleaseAsync(); return; }
                _ready = true;
            }
            catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
            {
                _failed = true;
                await ReleaseAsync();
            }
            if (!_disposed)
            {
                await ReadyChanged.InvokeAsync(_ready);
                StateHasChanged();
            }
        }
        if (_ready && !_disposed)
        {
            var module = _module!;
            await module.InvokeVoidAsync("setReadOnly", _host, ReadOnly);
            if (_disposed) return;
            if (!ReferenceEquals(Metadata, _sentMetadata))
            {
                _sentMetadata = Metadata;
                await module.InvokeVoidAsync("setMetadata", _host, Metadata);
            }
            if (_disposed) return;
            if (!ReferenceEquals(Diagnostics, _sentDiagnostics) || DiagnosticSource != _sentDiagnosticSource)
            {
                _sentDiagnostics = Diagnostics; _sentDiagnosticSource = DiagnosticSource;
                await module.InvokeVoidAsync("showDiagnostics", _host, DiagnosticSource, Diagnostics);
            }
        }
    }

    [JSInvokable]
    public async Task OnEditorChanged(string source, long revision)
    {
        if (_disposed || revision <= _revision) return;
        _revision = revision;
        _source = source;
        await SourceChanged.InvokeAsync(source);
    }

    [JSInvokable]
    public async Task OnCursorContextChanged(GlyphCursorContextDto context, long revision)
    {
        if (_disposed || revision <= _contextRevision) return;
        _contextRevision = revision;
        await CursorContextChanged.InvokeAsync(context);
    }

    [JSInvokable]
    public async Task OnDocumentationRequested(string canonicalName)
    {
        if (!_disposed && Metadata?.Functions.Any(f => f.CanonicalName == canonicalName) == true)
            await DocumentationRequested.InvokeAsync(canonicalName);
    }

    public async Task InsertFunctionAsync(GlyphFunctionMetadataDto function)
    {
        if (CanInsert) await _module!.InvokeVoidAsync("insertFunction", _host, function);
    }

    public async Task InsertConstantAsync(GlyphConstantMetadataDto constant)
    {
        if (CanInsert) await _module!.InvokeVoidAsync("insertConstant", _host, constant);
    }

    private async Task FallbackChanged(ChangeEventArgs args)
    {
        _source = args.Value?.ToString() ?? "";
        await SourceChanged.InvokeAsync(_source);
    }

    public async Task<string> CaptureAsync()
    {
        if (_ready)
        {
            var snapshot = await _module!.InvokeAsync<EditorSnapshot>("capture", _host);
            // Equal revisions are intentional: capture is also the initial source read.
            if (snapshot.Revision >= _revision)
            {
                _revision = snapshot.Revision;
                _source = snapshot.Source;
            }
        }
        return _source;
    }

    public async Task FocusDiagnosticAsync(string source, GlyphSourceSpanDto span)
    {
        if (_ready && !_disposed) await _module!.InvokeVoidAsync("focusDiagnostic", _host, source, span);
    }

    public sealed record EditorSnapshot(string Source, long Revision);

    private async Task ReleaseAsync()
    {
        var module = _module;
        _module = null;
        try
        {
            if (module != null)
            {
                try { await module.InvokeVoidAsync("destroy", _host); }
                finally { await module.DisposeAsync(); }
            }
        }
        catch (Exception ex) when (ex is JSException or TaskCanceledException) { }
        finally { _callback?.Dispose(); _callback = null; }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        await ReleaseAsync();
    }
}
