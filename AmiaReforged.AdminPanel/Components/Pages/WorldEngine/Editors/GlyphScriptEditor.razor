@using AmiaReforged.AdminPanel.Models
@using AmiaReforged.AdminPanel.Services
@inject GlyphApiService Api
@inject EncounterApiService EncounterApi
@inject TraitApiService TraitApi
@inject ILogger<GlyphScriptEditor> Logger

<div class="section">
@if (_selectedEndpointId == null)
{
    <p>Select a server from the World Engine toolbar to manage Glyph scripts.</p>
}
else
{
    <h3>Glyph scripts</h3>
    @if (_error != null) { <p role="alert">@_error</p> }
    @if (_success != null) { <p role="status">@_success</p> }
    @if (_showEditor)
    {
        <button class="btn btn-secondary" @onclick="CloseEditor">Back to list</button>
        <input aria-label="Script name" class="form-control my-2" @bind="_newName" disabled="@(_editingDefinition != null)" />
        <GlyphSourceEditor DefinitionId="_editingDefinition?.Id" Name="@_newName" Created="OnCreated" />
        @if (_editingDefinition != null)
        {
            <details><summary>Bindings</summary>
                <div class="my-2">
                    <label>Spawn profile</label>
                    <select @bind="_newSpawnBindingProfileId"><option value="">Select profile</option>
                        @foreach (var profile in _availableProfiles) { <option value="@profile.Id">@profile.Name</option> }
                    </select>
                    <input type="number" aria-label="Spawn priority" @bind="_newSpawnBindingPriority" />
                    <button disabled="@_isSaving" @onclick="AddSpawnBinding">Bind profile</button>
                </div>
                <div class="my-2">
                    <input aria-label="Trait tag" placeholder="Trait tag" @bind="_newTraitBindingTag" />
                    <input type="number" aria-label="Trait priority" @bind="_newTraitBindingPriority" />
                    <button disabled="@_isSaving" @onclick="AddTraitBinding">Bind trait</button>
                </div>
                <div class="my-2">
                    <input aria-label="Interaction tag" placeholder="Interaction tag" @bind="_newInteractionBindingTag" />
                    <input aria-label="Area scope" placeholder="Area (optional)" @bind="_newInteractionBindingAreaResRef" />
                    <input type="number" aria-label="Interaction priority" @bind="_newInteractionBindingPriority" />
                    <button disabled="@_isSaving" @onclick="AddInteractionBinding">Bind interaction</button>
                </div>
                @if (_definitionBindings != null)
                {
                    @foreach (var binding in _definitionBindings.SpawnProfileBindings)
                    { <p>@GetProfileName(binding.SpawnProfileId) <button @onclick="() => RemoveSpawnBinding(binding.Id)">Detach</button></p> }
                    @foreach (var binding in _definitionBindings.TraitBindings)
                    { <p>@binding.TraitTag <button @onclick="() => RemoveTraitBinding(binding.Id)">Detach</button></p> }
                    @foreach (var binding in _definitionBindings.InteractionBindings)
                    { <p>@binding.InteractionTag @binding.AreaResRef <button @onclick="() => RemoveInteractionBinding(binding.Id)">Detach</button></p> }
                }
            </details>
        }
    }
    else
    {
        <button class="btn btn-primary" @onclick="NewScript">New script</button>
        <table class="table"><thead><tr><th>Name</th><th>Event</th><th>Status</th><th>Actions</th></tr></thead><tbody>
            @foreach (var definition in _definitions)
            {
                <tr><td>@definition.Name</td><td>@definition.EventType</td><td>@(definition.IsActive ? "Active" : "Draft / inactive")</td><td>
                    <button class="btn btn-sm btn-primary" @onclick="() => OpenEditor(definition)">Edit</button>
                    @if (definition.IsActive) { <button class="btn btn-sm btn-warning" @onclick="() => Deactivate(definition)">Deactivate</button> }
                    <button class="btn btn-sm btn-danger" @onclick="() => _deleteTarget = definition">Delete</button>
                </td></tr>
            }
        </tbody></table>
    }
    @if (_deleteTarget != null)
    {
        <p>Delete @_deleteTarget.Name and all its bindings?</p>
        <button @onclick="DeleteDefinition">Delete definition</button>
        <button @onclick="() => _deleteTarget = null">Cancel</button>
    }
}
</div>
@code {
    private Guid? _selectedEndpointId;
    private List<GlyphDefinitionDto> _definitions = [];
    private GlyphDefinitionDto? _editingDefinition, _deleteTarget;
    private bool _showEditor, _isSaving;
    private string _newName = "New Glyph";
    private string? _error, _success;
    private DefinitionBindingsDto? _definitionBindings;
    private List<SpawnProfileDto> _availableProfiles = [];
    private string _newSpawnBindingProfileId = "", _newTraitBindingTag = "", _newInteractionBindingTag = "", _newInteractionBindingAreaResRef = "";
    private int _newSpawnBindingPriority, _newTraitBindingPriority, _newInteractionBindingPriority;
    public void SelectEndpoint(Guid? id)
    {
        _selectedEndpointId = id; _showEditor = false; _editingDefinition = null; _definitions = [];
        if (id is { } endpoint) { Api.SelectEndpoint(endpoint); EncounterApi.SelectEndpoint(endpoint); TraitApi.SelectEndpoint(endpoint); }
    }
    public async Task LoadListAsync()
    {
        if (_selectedEndpointId == null) return;
        try { _definitions = await Api.GetAllDefinitionsAsync(); _availableProfiles = await EncounterApi.GetAllProfilesAsync(); }
        catch (Exception ex) { _error = ex.Message; }
        StateHasChanged();
    }
    private void NewScript() { _newName = "New Glyph"; _editingDefinition = null; _showEditor = true; }
    private async Task OpenEditor(GlyphDefinitionDto definition)
    { _editingDefinition = definition; _newName = definition.Name; _showEditor = true; await LoadDefinitionBindings(definition.Id); }
    private async Task OnCreated(GlyphDefinitionDto definition)
    { _editingDefinition = definition; await LoadDefinitionBindings(definition.Id); }
    private async Task CloseEditor() { _showEditor = false; _editingDefinition = null; await LoadListAsync(); }
    private async Task Deactivate(GlyphDefinitionDto definition)
    {
        try { await Api.UpdateDefinitionAsync(definition.Id, new(IsActive: false)); await LoadListAsync(); }
        catch (Exception ex) { _error = ex.Message; }
    }
    private async Task DeleteDefinition()
    {
        try { if (_deleteTarget != null) await Api.DeleteDefinitionAsync(_deleteTarget.Id); _deleteTarget = null; await LoadListAsync(); }
        catch (Exception ex) { _error = ex.Message; }
    }
    private async Task LoadDefinitionBindings(Guid definitionId)
    {
        try
        {
            _definitionBindings = await Api.GetBindingsForDefinitionAsync(definitionId);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load bindings for definition {Id}", definitionId);
            _definitionBindings = new DefinitionBindingsDto([], [], []);
        }
    }

    private string GetProfileName(Guid profileId)
    {
        return _availableProfiles.FirstOrDefault(p => p.Id == profileId)?.Name ?? profileId.ToString()[..8] + "…";
    }

    private async Task AddSpawnBinding()
    {
        if (_editingDefinition == null || string.IsNullOrEmpty(_newSpawnBindingProfileId)) return;
        if (!Guid.TryParse(_newSpawnBindingProfileId, out Guid profileId)) return;

        _isSaving = true;
        try
        {
            await Api.CreateBindingAsync(new CreateGlyphBindingRequest(profileId, _editingDefinition.Id, _newSpawnBindingPriority));
            await LoadDefinitionBindings(_editingDefinition.Id);

            _newSpawnBindingProfileId = "";
            _newSpawnBindingPriority = 0;
            _success = "Spawn profile binding added.";
        }
        catch (Exception ex)
        {
            _error = $"Failed to add binding: {ex.Message}";
            Logger.LogError(ex, "Failed to add spawn binding");
        }
        finally { _isSaving = false; }
    }

    private async Task RemoveSpawnBinding(Guid bindingId)
    {
        if (_editingDefinition == null) return;
        try
        {
            await Api.DeleteBindingAsync(bindingId);
            await LoadDefinitionBindings(_editingDefinition.Id);
            _success = "Spawn profile binding removed.";
        }
        catch (Exception ex)
        {
            _error = $"Failed to remove binding: {ex.Message}";
            Logger.LogError(ex, "Failed to remove spawn binding");
        }
    }

    private async Task AddTraitBinding()
    {
        if (_editingDefinition == null || string.IsNullOrWhiteSpace(_newTraitBindingTag)) return;

        _isSaving = true;
        try
        {
            await Api.CreateTraitBindingAsync(new CreateTraitGlyphBindingRequest(
                _newTraitBindingTag.Trim(), _editingDefinition.Id, _newTraitBindingPriority));
            await LoadDefinitionBindings(_editingDefinition.Id);

            _newTraitBindingTag = "";
            _newTraitBindingPriority = 0;
            _success = "Trait binding added.";
        }
        catch (Exception ex)
        {
            _error = $"Failed to add trait binding: {ex.Message}";
            Logger.LogError(ex, "Failed to add trait binding");
        }
        finally { _isSaving = false; }
    }

    private async Task RemoveTraitBinding(Guid bindingId)
    {
        if (_editingDefinition == null) return;
        try
        {
            await Api.DeleteTraitBindingAsync(bindingId);
            await LoadDefinitionBindings(_editingDefinition.Id);
            _success = "Trait binding removed.";
        }
        catch (Exception ex)
        {
            _error = $"Failed to remove trait binding: {ex.Message}";
            Logger.LogError(ex, "Failed to remove trait binding");
        }
    }

    private async Task AddInteractionBinding()
    {
        if (_editingDefinition == null || string.IsNullOrWhiteSpace(_newInteractionBindingTag)) return;

        _isSaving = true;
        try
        {
            string? area = string.IsNullOrWhiteSpace(_newInteractionBindingAreaResRef)
                ? null
                : _newInteractionBindingAreaResRef.Trim();
            await Api.CreateInteractionBindingAsync(new CreateInteractionGlyphBindingRequest(
                _newInteractionBindingTag.Trim(), _editingDefinition.Id, area, _newInteractionBindingPriority));
            await LoadDefinitionBindings(_editingDefinition.Id);

            _newInteractionBindingTag = "";
            _newInteractionBindingAreaResRef = "";
            _newInteractionBindingPriority = 0;
            _success = "Interaction binding added.";
        }
        catch (Exception ex)
        {
            _error = $"Failed to add interaction binding: {ex.Message}";
            Logger.LogError(ex, "Failed to add interaction binding");
        }
        finally { _isSaving = false; }
    }

    private async Task RemoveInteractionBinding(Guid bindingId)
    {
        if (_editingDefinition == null) return;
        try
        {
            await Api.DeleteInteractionBindingAsync(bindingId);
            await LoadDefinitionBindings(_editingDefinition.Id);
            _success = "Interaction binding removed.";
        }
        catch (Exception ex)
        {
            _error = $"Failed to remove interaction binding: {ex.Message}";
            Logger.LogError(ex, "Failed to remove interaction binding");
        }
    }
}
