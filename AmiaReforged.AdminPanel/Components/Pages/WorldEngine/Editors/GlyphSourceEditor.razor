@using AmiaReforged.AdminPanel.Models
@using AmiaReforged.AdminPanel.Services
@inject GlyphApiService Api
@implements IDisposable

<div class="glyph-source-editor">
    <div class="glyph-source-toolbar">
        <span>@(LibraryMode ? $"Module: {ModuleName}" : "Glyph source")</span>
        @if (!LibraryMode && SourceLanguageVersion(_source) < 4)
        {
            <button type="button" class="btn btn-sm btn-secondary" disabled="@(_loading || _busy)" @onclick="UpgradeLanguage">Upgrade to Glyph 4</button>
        }
        <button type="button" class="btn btn-sm btn-secondary" aria-expanded="@_referenceOpen.ToString().ToLowerInvariant()" aria-controls="glyph-reference"
                @onclick="() => _referenceOpen = !_referenceOpen">@(_referenceOpen ? "Hide reference" : "Show reference")</button>
    </div>
    @if (_loading)
    {
        <p role="status">Loading Glyph source…</p>
    }
    else
    {
        <div class="glyph-source-workspace @(_referenceOpen ? "" : "glyph-source-workspace--solo")">
            <div class="glyph-source-code">
                <GlyphCodeEditor @key="_documentVersion" @ref="_editor" InitialSource="@_source"
                                 SourceChanged="OnSourceChanged" ReadOnly="@_busy" Metadata="_standardMetadata" ModuleMetadata="_moduleMetadata"
                                 Diagnostics="_diagnostics" DiagnosticSource="@_diagnosticSource" CursorContextChanged="OnCursorContextChanged" ReadyChanged="ready => _editorReady = ready" DocumentationRequested="OpenDocumentation" />
            </div>
            @if (_referenceOpen)
            {
                <GlyphReferencePanel @ref="_reference" Metadata="_metadata" Context="_cursorContext" Unavailable="_metadataUnavailable" Loading="_metadataLoading"
                                     CanInsert="@(_editorReady && !_busy)" Retry="RetryMetadata"
                                     InsertFunction="InsertFunction" InsertConstant="InsertConstant" />
            }
        </div>
    }
    @if (_metadataUnavailable)
    {
        <p role="status">Function suggestions are unavailable.
            <button class="btn btn-sm btn-link" @onclick="RetryMetadata" disabled="@_metadataLoading">Retry suggestions</button>
        </p>
    }
    <div class="d-flex flex-wrap gap-2 my-2">
        <button class="btn btn-secondary" disabled="@_busy" @onclick="Validate">Compile / validate</button>
        <button class="btn btn-secondary" disabled="@_busy" @onclick="SaveDraft">Save draft</button>
        <button class="btn btn-primary" disabled="@(_busy || !_valid || _validatedSource != _source)" @onclick="Activate">@(LibraryMode ? "Publish module" : "Activate")</button>
        <button class="btn btn-warning" disabled="@(_busy || _id == null || (LibraryMode ? _moduleVersions.FindIndex(v => v.IsActive) < 1 : _versions.Count < 2))" @onclick="Rollback">Rollback</button>
    </div>
    @if (_notice != null) { <p role="status">@_notice</p> }
    @if (_error != null) { <p role="alert" class="text-danger">@_error</p> }
    @if (_diagnostics.Count > 0)
    {
        <ul aria-label="Compiler diagnostics">
            @foreach (var diagnostic in _diagnostics)
            {
                <li><button class="btn btn-link text-start p-0" @onclick="() => FocusDiagnostic(diagnostic)">
                    <strong>@diagnostic.Code</strong> — @diagnostic.Span.SourceId — line @diagnostic.Span.Line, column @diagnostic.Span.Column: @diagnostic.Message
                </button></li>
            }
        </ul>
    }
    @if (LibraryMode && _moduleVersions.Count > 0)
    {
        <details><summary>Published module revisions</summary>
            @foreach (var version in _moduleVersions.AsEnumerable().Reverse())
            {
                <p>@version.PublishedAt.ToString("u") — @version.RevisionId — @(version.IsActive ? "Current" : "Retained")</p>
                @foreach (var dependency in version.Imports) { <p>Uses @dependency.Name revision @dependency.RevisionId</p> }
            }
        </details>
        <p>Publishing changes future compilations. Active scripts keep their existing module revisions.</p>
    }
    @if (_versions.Count > 0)
    {
        <details><summary>Version history</summary>
            <table class="table"><thead><tr><th>Activated</th><th>Version</th><th>Source hash</th><th>Status</th></tr></thead><tbody>
                @foreach (var version in _versions.AsEnumerable().Reverse())
                {
                    <tr><td>@version.ActivatedAt.ToString("u")</td><td>@version.VersionId</td><td>@version.SourceHash[..Math.Min(12, version.SourceHash.Length)]</td><td>@(version.IsActive ? "Active" : "Retained")</td></tr>
                }
            </tbody></table>
        </details>
    }
    @if (_id != null && !LibraryMode)
    {
        <details><summary>Runtime traces</summary>
            <button class="btn btn-sm btn-secondary" @onclick="LoadTraces" disabled="@_busy">Refresh traces</button>
            @foreach (var trace in _traces)
            {
                <p>@trace.RecordedAt.ToString("u") — @trace.Stage — version @trace.VersionId — @trace.Steps steps</p>
                <pre>@string.Join("\n", trace.Entries)</pre>
            }
        </details>
    }
</div>

@code {
    [Parameter] public Guid? DefinitionId { get; set; }
    [Parameter] public bool LibraryMode { get; set; }
    [Parameter] public string ModuleName { get; set; } = "interaction_helpers";
    [Parameter] public string Name { get; set; } = "New Glyph";
    [Parameter] public string InitialSource { get; set; } = "glyph new_program : interaction {\n    attempted { }\n    started { }\n    tick { }\n    completed { }\n}";
    [Parameter] public EventCallback<GlyphDefinitionDto> Created { get; set; }
    private bool _referenceOpen = true, _editorReady;
    private GlyphCursorContextDto? _cursorContext;
    private GlyphCodeEditor? _editor;
    private GlyphReferencePanel? _reference;
    private string? _pendingDocumentation;
    private int _documentVersion, _generation, _editRevision, _languageVersion = 4;
    private Guid? _id, _loadedParameter, _loadedEndpoint;
    private bool _initialized, _busy, _valid, _loading, _disposed, _metadataUnavailable, _metadataLoading;
    private string _source = "", _validatedSource = "", _diagnosticSource = "";
    private string? _notice, _error;
    private GlyphLanguageMetadataDto? _metadata, _standardMetadata;
    private string? _compilationHash;
    private GlyphModuleMetadataDto? _moduleMetadata;
    private string _moduleMetadataKey = "";
    private CancellationTokenSource? _moduleMetadataCancellation;
    private List<GlyphModuleVersionDto> _moduleVersions = [];
    private List<GlyphDiagnosticDto> _diagnostics = [];
    private List<GlyphVersionDto> _versions = [];
    private List<GlyphTraceDto> _traces = [];

    protected override async Task OnParametersSetAsync()
    {
        if (_initialized && _loadedEndpoint == Api.SelectedEndpointId &&
            (_loadedParameter == DefinitionId || _id == DefinitionId))
        { _loadedParameter = DefinitionId; return; }
        int generation = ++_generation;
        _initialized = true; _loadedParameter = DefinitionId; _id = DefinitionId;
        _loadedEndpoint = Api.SelectedEndpointId;
        _documentVersion++; _editRevision = 0; _languageVersion = 4; _editor = null; _cursorContext = null; _editorReady = false; _pendingDocumentation = null;
        _loading = true; _busy = true; _valid = false;
        _diagnostics = []; _versions = []; _moduleVersions = []; _traces = []; _metadata = null; _standardMetadata = null; _moduleMetadata = null; _moduleMetadataKey = ""; _compilationHash = null;
        _notice = null; _error = null; _metadataUnavailable = false;
        _source = InitialSource;
        _ = LoadMetadata(generation);
        try
        {
            if (_id is { } id)
            {
                if (LibraryMode)
                {
                    var library = await Api.GetModuleAsync(id);
                    CheckCurrent(generation);
                    _source = library?.SourceText ?? $"mod {ModuleName} {{\n\n}}";
                    _moduleVersions = library?.Versions ?? [];
                }
                else
                {
                var definition = await Api.GetDefinitionAsync(id);
                CheckCurrent(generation);
                var versions = await Api.GetVersionsAsync(id);
                CheckCurrent(generation);
                _source = definition?.SourceText ?? InitialSource; _languageVersion = definition?.LanguageVersion ?? 4;
                _versions = versions;
                }
            }
            _ = RefreshModuleMetadata(generation, _editRevision, _source);
        }
        catch (OperationCanceledException) when (!IsCurrent(generation)) { }
        catch (Exception ex) { if (IsCurrent(generation)) _error = ex.Message; }
        finally { if (IsCurrent(generation)) { _loading = false; _busy = false; } }
    }

    private bool IsCurrent(int generation) => !_disposed && generation == _generation && _loadedEndpoint == Api.SelectedEndpointId;
    private void CheckCurrent(int generation)
    {
        if (!IsCurrent(generation)) throw new OperationCanceledException();
    }
    private async Task LoadMetadata(int generation)
    {
        _metadataLoading = true;
        try
        {
            var metadata = await Api.GetLanguageMetadataAsync();
            if (IsCurrent(generation))
            {
                _metadata = metadata is { LanguageVersion: 1 or 2 or 3 or 4, Functions: not null, Events: not null, Contexts: not null } ? metadata : null;
                _standardMetadata = _metadata;
                _metadataUnavailable = _metadata == null;
                _ = RefreshModuleMetadata(generation, _editRevision, _source);
            }
        }
        catch (Exception) { if (IsCurrent(generation)) _metadataUnavailable = true; }
        finally
        {
            if (IsCurrent(generation))
            {
                _metadataLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }
    private void OnCursorContextChanged(GlyphCursorContextDto context) => _cursorContext = context;
    private Task InsertFunction(GlyphFunctionMetadataDto function) => !_busy && _metadata?.Functions.Contains(function) == true
        ? _editor?.InsertFunctionAsync(function) ?? Task.CompletedTask : Task.CompletedTask;
    private Task InsertConstant(GlyphConstantMetadataDto constant) => !_busy && _metadata?.Constants.Contains(constant) == true
        ? _editor?.InsertConstantAsync(constant) ?? Task.CompletedTask : Task.CompletedTask;
    private Task RetryMetadata() => LoadMetadata(_generation);
    private Task UpgradeLanguage()
    {
        _languageVersion = 4; _editRevision++;
        _valid = false; _compilationHash = null; _diagnostics = [];
        _notice = "Glyph 4 enabled. Compile / validate before activating.";
        _moduleMetadata = null; _metadata = _standardMetadata;
        return RefreshModuleMetadata(_generation, _editRevision, _source);
    }
    private void OnSourceChanged(string source)
    {
        if (_disposed || _loading || _source == source) return;
        _source = source; _editRevision++;
        _valid = false; _compilationHash = null; _notice = null; _diagnostics = [];
        if (ModuleMetadataKey(source) != _moduleMetadataKey)
        {
            _metadata = _standardMetadata; _moduleMetadata = null;
            _ = RefreshModuleMetadata(_generation, _editRevision, source, debounce: true);
        }
        _diagnosticSource = source;
    }
    private async Task<string> CaptureSource(int generation)
    {
        string source = _editor == null ? _source : await _editor.CaptureAsync();
        CheckCurrent(generation);
        OnSourceChanged(source);
        return source;
    }
    private async Task Run(Func<int, Task> action)
    {
        if (_busy || _disposed) return;
        int generation = _generation;
        _busy = true; _error = null;
        try { await action(generation); }
        catch (OperationCanceledException) when (!IsCurrent(generation)) { }
        catch (Exception ex) { if (IsCurrent(generation)) _error = ex.Message; }
        finally { if (IsCurrent(generation)) _busy = false; }
    }
    private Task Validate() => Run(async generation =>
    {
        string source = await CaptureSource(generation);
        int revision = _editRevision;
        var result = LibraryMode ? await Api.CompileModuleAsync(ModuleName, source) : await Api.CompileAsync(source, SourceLanguageVersion(source));
        CheckCurrent(generation);
        if (revision != _editRevision) return;
        _diagnostics = result?.Diagnostics ?? []; _diagnosticSource = source;
        _valid = result?.Success == true; _validatedSource = source; _compilationHash = result?.CompilationHash;
        await RefreshModuleMetadata(generation, revision, source);
        _notice = _valid ? LibraryMode ? "Compilation succeeded. Ready to publish." : "Compilation succeeded. Ready to activate." : "Compilation failed. Active behavior is unchanged.";
    });
    private async Task<Guid> EnsureDraft(string source, int generation)
    {
        if (_id is { } id) return id;
        if (LibraryMode) throw new InvalidOperationException("Create a module draft in the module list first.");
        var check = await Api.CompileAsync(source, SourceLanguageVersion(source));
        CheckCurrent(generation);
        if (check?.Success != true)
        {
            if (_source == source) { _diagnostics = check?.Diagnostics ?? []; _diagnosticSource = source; }
            throw new InvalidOperationException("Correct compilation errors before creating the first draft.");
        }
        var created = await Api.CreateDefinitionAsync(new(Name, "", SourceText: source));
        CheckCurrent(generation);
        if (created == null || created.Id == Guid.Empty) throw new InvalidOperationException("Draft was not created.");
        _id = created.Id;
        await Created.InvokeAsync(created);
        CheckCurrent(generation);
        return created.Id;
    }
    private Task SaveDraft() => Run(async generation =>
    {
        string source = await CaptureSource(generation);
        Guid id = await EnsureDraft(source, generation);
        CheckCurrent(generation);
        if (LibraryMode) await Api.SaveModuleAsync(id, new(ModuleName, source));
        else await Api.UpdateDefinitionAsync(id, new(SourceText: source));
        CheckCurrent(generation);
        _notice = "Draft saved. Active behavior is unchanged.";
    });
    private Task Activate() => Run(async generation =>
    {
        string source = await CaptureSource(generation);
        if (!_valid || _validatedSource != source)
            throw new InvalidOperationException("Compile / validate the current source before activating it.");
        int revision = _editRevision;
        Guid id = await EnsureDraft(source, generation);
        CheckCurrent(generation);
        if (revision != _editRevision || !_valid || _validatedSource != source)
            throw new InvalidOperationException("Compile / validate the current source before activating it.");
        var result = LibraryMode ? await Api.PublishModuleAsync(id, source, _compilationHash) : await Api.ActivateAsync(id, source, _compilationHash, SourceLanguageVersion(source));
        CheckCurrent(generation);
        if (revision == _editRevision)
        {
            _diagnostics = result?.Diagnostics ?? []; _diagnosticSource = source;
            _notice = result?.Success == true ? (LibraryMode ? "Module published. Recompile scripts to use this revision." : "Activated. New events use this version.") : "Publication failed. Previous behavior remains active.";
        }
        if (LibraryMode)
        {
            var library = await Api.GetModuleAsync(id); CheckCurrent(generation); _moduleVersions = library?.Versions ?? [];
        }
        else
        {
            var versions = await Api.GetVersionsAsync(id); CheckCurrent(generation); _versions = versions;
        }
    });
    private Task Rollback() => Run(async generation =>
    {
        Guid id = _id!.Value;
        if (LibraryMode)
        {
            var library = await Api.RollbackModuleAsync(id); CheckCurrent(generation);
            if (library == null) throw new InvalidOperationException("Module rollback did not succeed.");
            _source = library.SourceText; _moduleVersions = library.Versions; _editRevision++; _documentVersion++;
            _valid = false; _compilationHash = null; _diagnostics = []; _cursorContext = null; _editorReady = false;
            _notice = "Previous module revision selected for future compilations.";
            await RefreshModuleMetadata(generation, _editRevision, _source);
            return;
        }
        var result = await Api.RollbackAsync(id);
        CheckCurrent(generation);
        if (result?.Success != true) throw new InvalidOperationException("Rollback did not succeed.");
        _valid = false; _diagnostics = [];
        var definition = await Api.GetDefinitionAsync(id);
        CheckCurrent(generation);
        _source = definition!.SourceText; _languageVersion = definition.LanguageVersion; _editRevision++;
        _diagnosticSource = _source; _documentVersion++; _cursorContext = null; _editorReady = false;
        var versions = await Api.GetVersionsAsync(id);
        CheckCurrent(generation);
        _versions = versions;
        _notice = "Previous executable restored.";
    });
    private Task LoadTraces() => Run(async generation =>
    {
        var traces = await Api.GetTracesAsync(_id!.Value);
        CheckCurrent(generation);
        _traces = traces;
    });
    private Task FocusDiagnostic(GlyphDiagnosticDto diagnostic)
    {
        bool ownSource = diagnostic.Span.SourceId == "source.glyph" || diagnostic.Span.SourceId == $"{_id}.glyph" ||
            LibraryMode && diagnostic.Span.SourceId.StartsWith(ModuleName + "@", StringComparison.Ordinal);
        return ownSource ? _editor?.FocusDiagnosticAsync(_diagnosticSource, diagnostic.Span) ?? Task.CompletedTask : Task.CompletedTask;
    }
    public void Dispose() { _disposed = true; _generation++; _moduleMetadataCancellation?.Cancel(); _moduleMetadataCancellation?.Dispose(); }
    private static (string Code, int End) Prelude(string source)
    {
        // Keep offsets while ignoring comments and strings that mention glyph/import keywords.
        string code = System.Text.RegularExpressions.Regex.Replace(source, @"""(?:\\.|[^""\\])*""|//[^\r\n]*",
            match => new string(' ', match.Length));
        var declaration = System.Text.RegularExpressions.Regex.Match(code, @"\bglyph\b");
        return (code, declaration.Success ? declaration.Index : source.Length);
    }
    private int SourceLanguageVersion(string source)
    {
        if (LibraryMode) return 4;
        var prelude = Prelude(source);
        string code = prelude.Code[..prelude.End];
        if (System.Text.RegularExpressions.Regex.IsMatch(prelude.Code, @"\bimpl\s+[\p{L}_]|\b(?:List|Dictionary)\s*<|(?:^|[=(,]|\breturn)\s*\[")) return 4;
        if (System.Text.RegularExpressions.Regex.IsMatch(code, @"\bfn\s+[\p{L}_][\p{L}\p{Nd}_]*\s*\([^)]*\)\s*:\s*[\p{L}_][\p{L}\p{Nd}_.]*\s*\{")) return Math.Max(3, _languageVersion);
        return System.Text.RegularExpressions.Regex.IsMatch(code, @"\busing\s+[\p{L}_]") ? Math.Max(2, _languageVersion) : _languageVersion;
    }
    private string ModuleMetadataKey(string source) => LibraryMode ? source : source[..Prelude(source).End];
    private async Task RefreshModuleMetadata(int generation, int revision, string source, bool debounce = false)
    {
        _moduleMetadataCancellation?.Cancel(); _moduleMetadataCancellation?.Dispose();
        var cancellation = _moduleMetadataCancellation = new();
        try
        {
            if (debounce) await Task.Delay(350, cancellation.Token);
            if (_standardMetadata == null || !IsCurrent(generation) || revision != _editRevision || source != _source) return;
            var modules = await Api.GetModuleMetadataAsync(source, SourceLanguageVersion(source));
            if (!cancellation.IsCancellationRequested && IsCurrent(generation) && revision == _editRevision && source == _source && modules?.Functions != null)
            {
                _moduleMetadata = modules; _moduleMetadataKey = ModuleMetadataKey(source);
                _metadata = modules.Merge(_standardMetadata);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception) { /* Source editing and standard reference remain available if module metadata cannot load. */ }
    }
    private async Task OpenDocumentation(string canonicalName)
    {
        _referenceOpen = true;
        _pendingDocumentation = canonicalName;
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingDocumentation is not { } name || _reference == null) return;
        _pendingDocumentation = null;
        await _reference.OpenFunctionAsync(name);
    }

}
