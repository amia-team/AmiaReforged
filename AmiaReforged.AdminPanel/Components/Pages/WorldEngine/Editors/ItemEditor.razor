    private void RemoveAppearance() => _edit.Appearance = null;
    private void AddWeaponParts() { if (_edit.Appearance != null) _edit.Appearance.Data = new WeaponPartDataDto(); }
    private void RemoveWeaponParts() { if (_edit.Appearance != null) _edit.Appearance.Data = null; }

    // ===== Local Variable Helpers =====
    private string GetLocalVarDisplayValue(LocalVariableDto lv)
    {
        return lv.Value switch
        {
            JsonElement je => je.ValueKind == JsonValueKind.String ? je.GetString() ?? "" : je.GetRawText(),
            _ => lv.Value?.ToString() ?? ""
        };
    }

    private void SetLocalVarValue(LocalVariableDto lv, string text)
    {
        if (lv.Type == "Int" && int.TryParse(text, out int intVal))
            lv.Value = intVal;
        else if (lv.Type == "Json")
        {
            try { lv.Value = JsonDocument.Parse(text).RootElement.Clone(); }
            catch { lv.Value = text; }
        }
        else
            lv.Value = text;
    }

    private void AddLocalVariable()
    {
        _edit.LocalVariables ??= new List<LocalVariableDto>();
        _edit.LocalVariables.Add(new LocalVariableDto());
    }

    private void RemoveLocalVariable(int index)
    {
        if (_edit.LocalVariables != null && index >= 0 && index < _edit.LocalVariables.Count)
            _edit.LocalVariables.RemoveAt(index);
    }

    private void OnSimpleModelChanged(ChangeEventArgs e)
    {
        if (_edit.Appearance == null) return;
        _edit.Appearance.SimpleModelNumber = int.TryParse(e.Value?.ToString(), out int v) ? v : null;
    }

    // ===== Material Dropdown Helpers =====
    private void OnMaterialSearchInput(ChangeEventArgs e)
    {
        _materialSearch = e.Value?.ToString() ?? "";
        _showMaterialDropdown = true;
        RefreshFilteredMaterials();
    }

    private void OnMaterialSearchFocus()
    {
        _showMaterialDropdown = true;
        RefreshFilteredMaterials();
    }

    private void AddMaterial(string materialValue)
    {
        List<string> current = _edit.Materials?.ToList() ?? new();
        if (!current.Contains(materialValue))
        {
            current.Add(materialValue);
            _edit.Materials = current.ToArray();
        }
        _materialSearch = "";
        _showMaterialDropdown = false;
        RefreshFilteredMaterials();
    }

    private void RemoveMaterial(int index)
    {
        if (_edit.Materials == null || index < 0 || index >= _edit.Materials.Length) return;
        List<string> current = _edit.Materials.ToList();
        current.RemoveAt(index);
        _edit.Materials = current.Count > 0 ? current.ToArray() : null;
        RefreshFilteredMaterials();
    }

    private void RefreshFilteredMaterials()
    {
        HashSet<string> selected = new(_edit.Materials ?? []);
        _filteredMaterials = _allMaterials
            .Where(m => !selected.Contains(m.Value))
            .Where(m => string.IsNullOrEmpty(_materialSearch) ||
                        m.Label.Contains(_materialSearch, StringComparison.OrdinalIgnoreCase) ||
                        (m.Category ?? "").Contains(_materialSearch, StringComparison.OrdinalIgnoreCase))
            .OrderBy(m => m.Category ?? "ZZZ")
            .ThenBy(m => m.Label)
            .Take(30)
            .ToList();
    }

    private async Task DismissMaterialDropdownDelayed()
    {
        await Task.Delay(200);
        await InvokeAsync(() =>
        {
            _showMaterialDropdown = false;
        });
    }

    private string GetMaterialLabel(string value) =>
        _allMaterials.FirstOrDefault(m => m.Value == value)?.Label ?? value;

