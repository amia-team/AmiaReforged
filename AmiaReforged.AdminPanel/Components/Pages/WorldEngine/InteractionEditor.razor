@using System.Text.Json

@inject InteractionApiService Api
@inject GlyphApiService GlyphApi
@inject IndustryApiService IndustryApi
@inject IWorldEngineEditorCatalog EditorCatalog
@inject LayoutPresetService Presets
@inject ILogger<InteractionEditor> Logger
@inject IJSRuntime JS

@if (_isOpen)
{
<div class="interaction-editor" style="@(FillParent ? "position:relative;flex:1;min-height:0;background:var(--bg-dark);display:flex;flex-direction:column;overflow:hidden" : "position:fixed;inset:0;z-index:1040;background:var(--bg-dark);display:flex;flex-direction:column")">
    @* ═══════ Toolbar ═══════ *@
    <div style="display:flex;align-items:center;gap:12px;padding:6px 16px;background:var(--bg-card);border-bottom:1px solid var(--border-subtle);flex-shrink:0;height:42px;min-height:42px">
        <h5 style="margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:400px">
            @(_isCreating ? "New Interaction" : _editItem.Name)
        </h5>

        @if (!string.IsNullOrEmpty(_editItem.Tag))
        {
            <span class="badge" style="background:var(--bg-input);color:var(--text-secondary);font-size:0.75rem;font-weight:normal">@_editItem.Tag</span>
        }

        <div style="flex:1"></div>

        @* Save / Cancel *@
        @if (!string.IsNullOrEmpty(_error))
        {
            <span style="color:var(--danger);font-size:0.8rem;max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@_error">⚠ @_error</span>
        }
        <button class="btn btn-sm btn-secondary" @onclick="Cancel">Cancel</button>
        <button class="btn btn-sm btn-primary" @onclick="Save" disabled="@_isSaving">
            @(_isSaving ? "Saving..." : (_isCreating ? "Create" : "Save"))
        </button>
        <button class="btn btn-sm" style="background:none;border:none;color:var(--text-secondary);font-size:1.2rem;padding:0 4px;cursor:pointer" @onclick="Cancel" title="Close">✕</button>
    </div>

    @* ═══════ Workspace (split layout — no layout framework) ═══════ *@
    <div class="interaction-editor__workspace">
            <ResizableSplit Direction="horizontal" FirstDefaultWidth="@_inspectorWidth" FirstMin="260" SecondMin="400"
                            PersistKey="interaction-inspector" SwapOrder="true"
                            CollapsibleFirst="true" CollapsibleSecond="false"
                            FirstCollapsedInitial="@_inspectorCollapsed"
                            OnFirstCollapsedChanged="OnInspectorCollapsedChanged">
                <Second>
                    @if (_isCreating)
                    {
                        <p class="p-3">Save the interaction before creating and activating its Glyph program.</p>
                    }
                    else
                    {
                        <AmiaReforged.AdminPanel.Components.Pages.WorldEngine.Editors.GlyphSourceEditor
                            @key="_editItem.Tag" DefinitionId="_pipelineScript?.Id" Name="@($"{_editItem.Tag}/Pipeline")" Created="BindPipeline" />
                    }
                </Second>
                <First>
                    @{
                        RenderFragment? interactionInspectorFooter = HasInspectorBottomExtensions
                            ? @<EditorExtensionPoint Slot="@WorldEngineEditorExtensionSlot.InspectorBottom" Context="@(HostContext!)" />
                            : null;
                    }
                    <Inspector Title="Properties" OnClose="@Cancel" Footer="@interactionInspectorFooter">
                        <HeaderActions>
                            @if (HostContext != null)
                            {
                                <EditorExtensionPoint Slot="@WorldEngineEditorExtensionSlot.InspectorTop" Context="@HostContext" />
                            }
                        </HeaderActions>
                        <Body>
    @* ── Form / Properties Panel ── *@
        <div style="background:var(--bg-card);padding:12px;min-height:100%">
            <h5 style="margin:0 0 10px 0;font-size:0.9rem">Interaction Properties</h5>

            @* Basic Fields *@
            <div class="form-group" style="margin-bottom:8px">
                <label style="font-size:0.8rem">Tag</label>
                <input class="form-control form-control-sm" @bind="_editItem.Tag" disabled="@(!_isCreating)" placeholder="e.g. prospect_minerals" />
            </div>
            <div class="form-group" style="margin-bottom:8px">
                <label style="font-size:0.8rem">Name</label>
                <input class="form-control form-control-sm" @bind="_editItem.Name" placeholder="e.g. Prospect for Minerals" />
            </div>
            <div class="form-group" style="margin-bottom:8px">
                <label style="font-size:0.8rem">Description</label>
                <textarea class="form-control form-control-sm" rows="2" @bind="_editItem.Description" placeholder="Optional description..."></textarea>
            </div>

            <div style="display:flex;gap:8px;margin-bottom:8px">
                <div class="form-group" style="flex:1">
                    <label style="font-size:0.8rem">Target Mode</label>
                    <select class="form-control form-control-sm" @bind="_editItem.TargetMode">
                        <option value="Node">Node</option>
                        <option value="Trigger">Trigger</option>
                        <option value="Placeable">Placeable</option>
                    </select>
                </div>
                <div class="form-group" style="flex:1">
                    <label style="font-size:0.8rem">Base Rounds</label>
                    <input class="form-control form-control-sm" type="number" min="1" @bind="_editItem.BaseRounds" />
                </div>
                <div class="form-group" style="flex:1">
                    <label style="font-size:0.8rem">Min Rounds</label>
                    <input class="form-control form-control-sm" type="number" min="1" @bind="_editItem.MinRounds" />
                </div>
            </div>

            <div style="display:flex;flex-direction:column;gap:4px;margin-bottom:10px">
                <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:0.8rem">
                    <input type="checkbox" @bind="_editItem.ProficiencyReducesRounds" />
                    Proficiency Reduces Rounds
                </label>
                <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:0.8rem">
                    <input type="checkbox" @bind="_editItem.RequiresIndustryMembership" />
                    Requires Industry Membership
                </label>
            </div>

            @* ── Validity & Context ── *@
            <div style="border:1px solid var(--border-subtle);border-radius:6px;padding:10px;margin-bottom:10px">
                <h6 style="margin:0 0 8px 0;font-size:0.85rem">Validity &amp; Context</h6>

                @* Required Industries *@
                <div class="form-group" style="margin-bottom:8px">
                    <label style="font-size:0.78rem">Required Industries</label>
                    <div style="display:flex;flex-wrap:wrap;gap:4px;margin-bottom:4px">
                        @foreach (string tag in _editItem.RequiredIndustryTags)
                        {
                            string capturedTag = tag;
                            <span style="display:inline-flex;align-items:center;gap:3px;background:rgba(0,200,200,0.15);border:1px solid rgba(0,200,200,0.3);border-radius:3px;padding:1px 6px;font-size:0.75rem">
                                @capturedTag
                                <button type="button" style="background:none;border:none;color:var(--text-secondary);cursor:pointer;padding:0;font-size:0.7rem" @onclick="() => _editItem.RequiredIndustryTags.Remove(capturedTag)">✕</button>
                            </span>
                        }
                    </div>
                    @if (_availableIndustries.Count > 0)
                    {
                        <select class="form-control form-control-sm" style="font-size:0.78rem" @onchange="OnIndustrySelected">
                            <option value="">— Add industry —</option>
                            @foreach (var ind in _availableIndustries.Where(i => !_editItem.RequiredIndustryTags.Contains(i.Tag)))
                            {
                                <option value="@ind.Tag">@ind.Name (@ind.Tag)</option>
                            }
                        </select>
                    }
                </div>

                @* Allowed Areas *@
                <div class="form-group" style="margin-bottom:8px">
                    <label style="font-size:0.78rem">Allowed Areas</label>
                    <div style="display:flex;flex-wrap:wrap;gap:4px;margin-bottom:4px">
                        @foreach (string area in _editItem.AllowedAreaResRefs)
                        {
                            string capturedArea = area;
                            <span style="display:inline-flex;align-items:center;gap:3px;background:rgba(200,200,0,0.15);border:1px solid rgba(200,200,0,0.3);border-radius:3px;padding:1px 6px;font-size:0.75rem">
                                @capturedArea
                                <button type="button" style="background:none;border:none;color:var(--text-secondary);cursor:pointer;padding:0;font-size:0.7rem" @onclick="() => _editItem.AllowedAreaResRefs.Remove(capturedArea)">✕</button>
                            </span>
                        }
                    </div>
                    <div style="display:flex;gap:4px">
                        <input class="form-control form-control-sm" style="font-size:0.78rem" @bind="_newAreaResRef" placeholder="area_resref" @onkeydown="OnAreaKeyDown" />
                        <button type="button" class="btn btn-sm btn-outline-info" style="font-size:0.72rem;padding:2px 6px" @onclick="AddAreaResRef">Add</button>
                    </div>
                </div>

                @* Required Knowledge *@
                <div class="form-group">
                    <label style="font-size:0.78rem">Required Knowledge</label>
                    <div style="display:flex;flex-wrap:wrap;gap:4px;margin-bottom:4px">
                        @foreach (string k in _editItem.RequiredKnowledgeTags)
                        {
                            string capturedK = k;
                            <span style="display:inline-flex;align-items:center;gap:3px;background:rgba(200,0,200,0.15);border:1px solid rgba(200,0,200,0.3);border-radius:3px;padding:1px 6px;font-size:0.75rem">
                                @capturedK
                                <button type="button" style="background:none;border:none;color:var(--text-secondary);cursor:pointer;padding:0;font-size:0.7rem" @onclick="() => _editItem.RequiredKnowledgeTags.Remove(capturedK)">✕</button>
                            </span>
                        }
                    </div>
                    <div style="display:flex;gap:4px">
                        <input class="form-control form-control-sm" style="font-size:0.78rem" @bind="_newKnowledgeTag" placeholder="knowledge_tag" @onkeydown="OnKnowledgeKeyDown" />
                        <button type="button" class="btn btn-sm btn-outline-info" style="font-size:0.72rem;padding:2px 6px" @onclick="AddKnowledgeTag">Add</button>
                    </div>
                </div>
            </div>
        </div>

    @* ── Responses Panel ── *@
        <div style="background:var(--bg-card);padding:12px;min-height:100%">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
                <h5 style="margin:0;font-size:0.9rem">Responses (@_editItem.Responses.Count)</h5>
                <button class="btn btn-sm btn-outline-info" style="font-size:0.72rem;padding:2px 8px" @onclick="AddResponse">+ Add</button>
            </div>

            @if (_editItem.Responses.Count == 0)
            {
                <p style="color:var(--text-secondary);font-size:0.8rem">No responses defined. Add at least one.</p>
            }

            @for (int ri = 0; ri < _editItem.Responses.Count; ri++)
            {
                int rIdx = ri;
                InteractionResponseDto response = _editItem.Responses[rIdx];
                <div style="border:1px solid var(--border-subtle);border-radius:5px;padding:10px;margin-bottom:8px;background:rgba(255,255,255,0.02)">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
                        <strong style="font-size:0.8rem">Response #@(rIdx + 1)</strong>
                        <button class="btn btn-sm btn-outline-danger" style="font-size:0.68rem;padding:1px 5px" @onclick="() => RemoveResponse(rIdx)">✕</button>
                    </div>

                    <div style="display:flex;gap:6px;margin-bottom:6px">
                        <div class="form-group" style="flex:2">
                            <label style="font-size:0.72rem">Tag</label>
                            <input class="form-control form-control-sm" style="font-size:0.78rem" @bind="response.ResponseTag" placeholder="e.g. find_iron_ore" />
                        </div>
                        <div class="form-group" style="flex:1">
                            <label style="font-size:0.72rem">Weight</label>
                            <input class="form-control form-control-sm" style="font-size:0.78rem" type="number" min="1" @bind="response.Weight" />
                        </div>
                        <div class="form-group" style="flex:1">
                            <label style="font-size:0.72rem">Min Prof.</label>
                            <select class="form-control form-control-sm" style="font-size:0.78rem" @bind="response.MinProficiency">
                                <option value="">None</option>
                                <option value="Layman">Layman</option>
                                <option value="Novice">Novice</option>
                                <option value="Apprentice">Apprentice</option>
                                <option value="Journeyman">Journeyman</option>
                                <option value="Expert">Expert</option>
                                <option value="Master">Master</option>
                                <option value="Grandmaster">Grandmaster</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group" style="margin-bottom:6px">
                        <label style="font-size:0.72rem">Message</label>
                        <input class="form-control form-control-sm" style="font-size:0.78rem" @bind="response.Message" placeholder="Text shown to the player..." />
                    </div>

                    @* Effects *@
                    <div style="border:1px solid var(--border-subtle);border-radius:4px;padding:8px;background:rgba(0,0,0,0.15)">
                        <div style="display:flex;justify-content:space-between;align-items:center">
                            <span style="font-size:0.75rem;font-weight:600">Effects (@response.Effects.Count)</span>
                            <button class="btn btn-sm btn-outline-info" style="font-size:0.68rem;padding:1px 6px" @onclick="() => AddEffect(rIdx)">+ Effect</button>
                        </div>

                        @if (response.Effects.Count == 0)
                        {
                            <p style="color:var(--text-secondary);font-size:0.72rem;margin:4px 0 0 0">No effects.</p>
                        }

                        @for (int ei = 0; ei < response.Effects.Count; ei++)
                        {
                            int eIdx = ei;
                            InteractionResponseEffectDto effect = response.Effects[eIdx];
                            <div style="display:flex;gap:6px;align-items:end;margin-top:4px">
                                <div class="form-group" style="flex:1">
                                    @if (eIdx == 0) { <label style="font-size:0.7rem">Type</label> }
                                    <select class="form-control form-control-sm" style="font-size:0.78rem" @bind="effect.EffectType">
                                        <option value="">— Select —</option>
                                        <option value="FloatingText">FloatingText</option>
                                        <option value="VfxAtLocation">VfxAtLocation</option>
                                        <option value="VfxOnPlayer">VfxOnPlayer</option>
                                        <option value="SpawnResourceNode">SpawnResourceNode</option>
                                        <option value="DirectionalHint">DirectionalHint</option>
                                        <option value="Custom">Custom</option>
                                    </select>
                                </div>
                                <div class="form-group" style="flex:2">
                                    @if (eIdx == 0) { <label style="font-size:0.7rem">Value</label> }
                                    <input class="form-control form-control-sm" style="font-size:0.78rem" @bind="effect.Value" placeholder="@GetEffectValueHint(effect.EffectType)" />
                                </div>
                                <button class="btn btn-sm btn-outline-danger" style="font-size:0.68rem;padding:1px 4px;margin-bottom:2px" @onclick="() => RemoveEffect(rIdx, eIdx)">✕</button>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

                        </Body>
                    </Inspector>
                </First>
            </ResizableSplit>
    </div>
</div>
}

@code {
    // Host context flows from the WorldEngineEditor shell cascade; null when
    // rendered standalone (e.g. bUnit tests).
    [CascadingParameter] public WorldEngineEditorHostContext? HostContext { get; set; }

    private bool HasInspectorBottomExtensions =>
        HostContext != null
        && EditorCatalog.GetExtensions(WorldEngineEditorExtensionSlot.InspectorBottom, HostContext).Count > 0;

    // ═══════════════════════════════════════════════════════════════════
    //  Parameters
    // ═══════════════════════════════════════════════════════════════════

    /// <summary>Available industries for the dropdown (loaded by parent).</summary>
    [Parameter] public List<IndustryDefinitionDto> AvailableIndustries { get; set; } = [];

    /// <summary>Raised when the editor is closed (saved or cancelled).</summary>
    [Parameter] public EventCallback<InteractionEditorResult> OnClosed { get; set; }

    /// <summary>
    /// Tab-mode entry point. When <see cref="OpenOnParameters"/> is true the
    /// editor auto-opens for <see cref="EntityTag"/> (or a blank new entry
    /// when <see cref="IsNew"/>) instead of waiting for an imperative
    /// <c>OpenCreate</c>/<c>OpenEdit</c> call. <see cref="FillParent"/> renders
    /// in-flow (for tab content) instead of as a fixed full-screen overlay.
    /// </summary>
    [Parameter] public string? EntityTag { get; set; }
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public bool OpenOnParameters { get; set; }
    [Parameter] public bool FillParent { get; set; }

    // ═══════════════════════════════════════════════════════════════════
    //  State
    // ═══════════════════════════════════════════════════════════════════

    // Tab-mode auto-open tracking (see OpenOnParameters).
    private bool _autoOpened;
    private string? _autoOpenedTag;
    private bool _autoOpenedIsNew;

    protected override async Task OnParametersSetAsync()
    {
        if (!OpenOnParameters) return;

        if (_autoOpened && _autoOpenedTag == EntityTag && _autoOpenedIsNew == IsNew) return;

        _autoOpened = true;
        _autoOpenedTag = EntityTag;
        _autoOpenedIsNew = IsNew;

        if (IsNew || EntityTag is null)
        {
            await OpenCreate();
            return;
        }

        try
        {
            InteractionDefinitionDto? loaded = await Api.GetByTagAsync(EntityTag);
            if (loaded == null)
            {
                _error = $"Interaction '{EntityTag}' not found.";
                return;
            }
            await OpenEdit(loaded);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to open interaction editor for {Tag}", EntityTag);
            _error = $"Failed to load: {ex.Message}";
        }
    }

    private bool _isOpen;
    private bool _isCreating;
    private bool _isSaving;
    private string? _error;
    private InteractionDefinitionDto _editItem = new();

    // Rail presets (LayoutPresetService; splitter.js persists widths)
    private bool _inspectorCollapsed;
    private int _inspectorWidth = 320;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            EditorPreset preset = await Presets.GetPresetAsync(WorldEngineEntityType.Interactions);
            _inspectorCollapsed = !preset.InspectorOpen;
            _inspectorWidth = Math.Max(260, preset.InspectorWidth);
        }
        catch { }
    }

    private async Task OnInspectorCollapsedChanged(bool collapsed)
    {
        _inspectorCollapsed = collapsed;
        try
        {
            await Presets.UpdatePresetAsync(
                WorldEngineEntityType.Interactions, p => p with { InspectorOpen = !collapsed });
        }
        catch { }
    }

    // Validity / Context helpers
    private List<IndustryDefinitionDto> _availableIndustries = [];
    private string _newAreaResRef = "";
    private string _newKnowledgeTag = "";

    private GlyphDefinitionDto? _pipelineScript;
    private void ResetScriptState() => _pipelineScript = null;

    /// <summary>Open the editor for a new interaction.</summary>
    public Task OpenCreate()
    {
        Logger.LogInformation("[IE] OpenCreate called. Industries available: {Count}", AvailableIndustries.Count);
        _isCreating = true;
        _editItem = new InteractionDefinitionDto
        {
            TargetMode = "Trigger",
            BaseRounds = 4,
            MinRounds = 2,
            ProficiencyReducesRounds = true,
            RequiresIndustryMembership = true,
            RequiredIndustryTags = [],
            AllowedAreaResRefs = [],
            RequiredKnowledgeTags = [],
        };
        _availableIndustries = AvailableIndustries;
        ResetScriptState();
        _error = null;
        _isOpen = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>Open the editor for an existing interaction.</summary>
    public async Task OpenEdit(InteractionDefinitionDto item)
    {
        Logger.LogInformation("[IE] OpenEdit called for tag={Tag}. Industries available: {Count}", item.Tag, AvailableIndustries.Count);
        _isCreating = false;
        _editItem = DeepCopy(item);
        _availableIndustries = AvailableIndustries;
        ResetScriptState();
        _error = null;
        _isOpen = true;
        StateHasChanged();
        await LoadInteractionScripts(item.Tag);
    }

    // ═══════════════════════════════════════════════════════════════════
    //  Layout Lifecycle (split-based; no layout framework)
    // ═══════════════════════════════════════════════════════════════════

    private async Task Save()
    {
        _isSaving = true;
        _error = null;
        try
        {

            if (_isCreating)
                await Api.CreateAsync(_editItem);
            else
                await Api.UpdateAsync(_editItem.Tag, _editItem);


            _isOpen = false;
            StateHasChanged();

            await OnClosed.InvokeAsync(new InteractionEditorResult
            {
                Saved = true,
                InteractionTag = _editItem.Tag,
                IsNew = _isCreating,
                Message = _isCreating
                    ? $"Interaction '{_editItem.Name}' created."
                    : $"Interaction '{_editItem.Name}' updated.",
            });
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Logger.LogError(ex, "Failed to save interaction");
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    /// <summary>Force-close the editor from the parent (e.g. when switching activity bar tabs).</summary>
    public async Task Close()
    {
        _isOpen = false;
        _error = null;
        StateHasChanged();
        await OnClosed.InvokeAsync(new InteractionEditorResult { Saved = false });
    }

    private async Task Cancel()
    {
        await Close();
    }

    // ═══════════════════════════════════════════════════════════════════
    //  Script Editor Lifecycle
    // ═══════════════════════════════════════════════════════════════════

    private async Task LoadInteractionScripts(string tag)
    {
        try
        {
            var bindings = await GlyphApi.GetInteractionBindingsAsync(tag);
            var binding = bindings.FirstOrDefault(b => b.EventType == "InteractionPipeline");
            _pipelineScript = binding == null ? null : await GlyphApi.GetDefinitionAsync(binding.GlyphDefinitionId);
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task BindPipeline(GlyphDefinitionDto definition)
    {
        if (string.IsNullOrWhiteSpace(_editItem.Tag)) throw new InvalidOperationException("Set an interaction tag before creating its script.");
        await GlyphApi.CreateInteractionBindingAsync(new(_editItem.Tag, definition.Id));
        _pipelineScript = definition;
    }

    private void OnIndustrySelected(ChangeEventArgs e)
    {
        string? tag = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(tag) && !_editItem.RequiredIndustryTags.Contains(tag))
            _editItem.RequiredIndustryTags.Add(tag);
    }

    private void AddAreaResRef()
    {
        string val = _newAreaResRef.Trim();
        if (!string.IsNullOrEmpty(val) && !_editItem.AllowedAreaResRefs.Contains(val))
        {
            _editItem.AllowedAreaResRefs.Add(val);
            _newAreaResRef = "";
        }
    }

    private void OnAreaKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") AddAreaResRef(); }

    private void AddKnowledgeTag()
    {
        string val = _newKnowledgeTag.Trim();
        if (!string.IsNullOrEmpty(val) && !_editItem.RequiredKnowledgeTags.Contains(val))
        {
            _editItem.RequiredKnowledgeTags.Add(val);
            _newKnowledgeTag = "";
        }
    }

    private void OnKnowledgeKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") AddKnowledgeTag(); }

    // ═══════════════════════════════════════════════════════════════════
    //  Response / Effect Management
    // ═══════════════════════════════════════════════════════════════════

    private void AddResponse()
    {
        _editItem.Responses.Add(new InteractionResponseDto { ResponseTag = "", Weight = 1 });
    }

    private void RemoveResponse(int index)
    {
        if (index >= 0 && index < _editItem.Responses.Count)
            _editItem.Responses.RemoveAt(index);
    }

    private void AddEffect(int responseIndex)
    {
        if (responseIndex >= 0 && responseIndex < _editItem.Responses.Count)
            _editItem.Responses[responseIndex].Effects.Add(new InteractionResponseEffectDto());
    }

    private void RemoveEffect(int responseIndex, int effectIndex)
    {
        if (responseIndex >= 0 && responseIndex < _editItem.Responses.Count)
        {
            List<InteractionResponseEffectDto> effects = _editItem.Responses[responseIndex].Effects;
            if (effectIndex >= 0 && effectIndex < effects.Count)
                effects.RemoveAt(effectIndex);
        }
    }

    // ═══════════════════════════════════════════════════════════════════
    //  Helpers
    // ═══════════════════════════════════════════════════════════════════

    private static InteractionDefinitionDto DeepCopy(InteractionDefinitionDto src) => new()
    {
        Tag = src.Tag,
        Name = src.Name,
        Description = src.Description,
        TargetMode = src.TargetMode,
        BaseRounds = src.BaseRounds,
        MinRounds = src.MinRounds,
        ProficiencyReducesRounds = src.ProficiencyReducesRounds,
        RequiresIndustryMembership = src.RequiresIndustryMembership,
        RequiredIndustryTags = [..src.RequiredIndustryTags],
        AllowedAreaResRefs = [..src.AllowedAreaResRefs],
        RequiredKnowledgeTags = [..src.RequiredKnowledgeTags],
        CreatedAt = src.CreatedAt,
        UpdatedAt = src.UpdatedAt,
        Responses = src.Responses.Select(r => new InteractionResponseDto
        {
            ResponseTag = r.ResponseTag,
            Weight = r.Weight,
            MinProficiency = r.MinProficiency,
            Message = r.Message,
            Effects = r.Effects.Select(e => new InteractionResponseEffectDto
            {
                EffectType = e.EffectType,
                Value = e.Value,
                Metadata = e.Metadata != null ? new Dictionary<string, object>(e.Metadata) : null,
            }).ToList(),
        }).ToList(),
    };

    private static string GetEffectValueHint(string effectType) => effectType switch
    {
        "FloatingText" => "Text to display...",
        "VfxAtLocation" => "VFX constant (int)",
        "VfxOnPlayer" => "VFX constant (int)",
        "SpawnResourceNode" => "Node tag to spawn",
        "DirectionalHint" => "Hint parameters...",
        "Custom" => "Custom value...",
        _ => "Value..."
    };

}
