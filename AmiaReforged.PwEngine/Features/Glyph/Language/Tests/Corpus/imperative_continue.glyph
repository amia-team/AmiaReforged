glyph filter_inventory : interaction {
    completed {
        for item in player.inventory() {
            if item.get_tag() == "keep" { continue }
            item.destroy()
        }
        for outer in 0..10 {
            for inner in 0..10 {
                if outer == inner { continue }
                if inner > 5 { break }
                player.set_local_int("pair", outer * 10 + inner)
            }
        }
    }
}
