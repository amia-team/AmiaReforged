glyph clean_inventory : interaction {
    completed {
        for item in nwn.inventory(player) {
            if nwn.get_tag(item) == "temporary_item" { nwn.destroy_object(item) }
        }
        for effect_value in nwn.effects(player) {
            if nwn.get_effect_type(effect_value) == EFFECT_TYPE.HASTE { nwn.remove_effect(player, effect_value) }
        }
    }
}
