struct Request { actor: Object, amount: Int, }
type Result {
    Found { target: Object, },
    Missing { reason: String, },
}
fn found(request: Request): Result = Result.Found(target: request.actor)

glyph runtime_match : interaction {
    completed {
        let target = nwn.nearest_object_by_kind(player, "creature")
        var request = Request(actor: target, amount: 5)
        var result = Result.Missing(reason: "No nearby creature")
        if nwn.get_is_object_valid(target) { result = found(request) }
        match result {
            Found { target } { nwn.set_local_int(target, "found", request.amount) }
            Missing { reason } { message(player, reason) }
        }
    }
}
