glyph mark_nearby_creatures : interaction {
    completed {
        foreach creature in nwn.objects_in_area(player.get_area(), OBJECT_TYPE.CREATURE) {
            if creature.get_distance(player) < 10.0 && creature != player {
                creature.set_local_object("near_player", player)
                if creature.is_dead() { creature.set_local_string("state", "fallen") }
            }
        }
    }
}
