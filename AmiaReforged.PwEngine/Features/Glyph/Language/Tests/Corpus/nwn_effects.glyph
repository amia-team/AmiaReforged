const HASTE_EFFECT = EFFECT_TYPE.HASTE
fn is_haste(aura: Effect): Bool = nwn.get_effect_type(aura) == HASTE_EFFECT

glyph spectral_blessing : interaction {
    completed {
        foreach aura in nwn.effects(player) {
            if is_haste(aura) { nwn.remove_effect(player, aura) }
        }
        nwn.apply_effect_to_object(player, effect.visual_effect(VFX.DUR_AURA_PURPLE))
        nwn.apply_effect_to_object(player, effect.haste(), duration: 30.0)
        nwn.apply_effect_to_object(player, effect.ac_increase(4), duration: 30.0)
        nwn.apply_effect_to_object(player, effect.damage_resistance(DAMAGE_TYPE.FIRE, 10), duration: 30.0)
    }
}
