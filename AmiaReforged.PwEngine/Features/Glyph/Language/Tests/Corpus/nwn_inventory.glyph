glyph collect_quest_tokens : interaction {
    completed {
        foreach item in nwn.inventory(player) {
            if nwn.get_tag(item) == "amia_quest_item" {
                nwn.set_local_int(player, "collected_tokens", nwn.get_local_int(player, "collected_tokens") + nwn.get_item_stack_size(item))
                nwn.destroy_object(item)
            }
        }
        let reward = nwn.create_item_on_object("amia_quest_reward", player)
        nwn.set_local_object(reward, "reward_owner", player)
    }
}
