glyph haunted_door : interaction {
    completed {
        let door = nwn.get_nearest_object_by_type(player, OBJECT_TYPE.DOOR)
        if nwn.get_is_object_valid(door) {
            let uses = nwn.get_local_int(door, "haunt_uses")
            nwn.set_local_int(door, "haunt_uses", uses + 1)
            nwn.set_local_object(door, "last_visitor", player)
            nwn.set_local_float(door, "last_distance", nwn.get_distance_between(door, player))
            nwn.set_local_location(door, "visitor_location", nwn.get_location(player))
            if uses >= 3 {
                nwn.set_local_int(door, "exhausted", 1)
                nwn.set_locked(door, true)
            }
        }
    }
}
