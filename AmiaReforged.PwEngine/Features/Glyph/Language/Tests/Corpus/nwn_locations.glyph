glyph return_home : interaction {
    completed {
        let current = nwn.get_location(player)
        let home = nwn.location(current.get_area(), current.get_x(), current.get_y(), current.get_z(), current.get_facing())
        nwn.set_local_location(player, "last_safe_location", home)
        nwn.jump_to_location(player, nwn.get_local_location(player, "last_safe_location"))
        nwn.action_move_to_location(player, home, run: false)
    }
}
