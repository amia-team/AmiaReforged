fn restore_trait(): Void {
    trait.add_effect(effect.ac_increase(2))
    trait.add_effect(effect.damage_resistance(DAMAGE_TYPE.FIRE, 5))
}

glyph resilient : trait.on_effect_resolution {
    main { restore_trait() }
    respawn { floating_text(creature, "Your protection returns.") }
    death {
        if nwn.get_is_object_valid(killer) {
            floating_text(creature, "Your protection fades.")
        }
    }
}
